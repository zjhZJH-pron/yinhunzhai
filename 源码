      enableHints(app);
    },
    wellOpened(){
      S.seenCutscenes[name]=true;
      app.hud.say({who:'井 中',glyph:'？',
        text:'绳上有人在往下抹泥。你抬头，井口只有一圈青白的天。\n很轻的一声：「<b>钥匙拿走，绳子给我留一条</b>。」'});
    },
    stageEnter(){
      S.seenCutscenes[name]=true;
      app.hud.say({who:'阮香绫',glyph:'绫',
        text:'台上那人正唱到「寻魂」。她一个转身，眼风压着鼓点打过来。\n「好。又来了个听戏的。」\n「我这出戏缺一角 —— 缺个不走的。」'});
