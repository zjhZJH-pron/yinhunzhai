    <div class="lamp-bar"><i id="lampFill"></i></div>
    <div class="lamp-num" id="lampNum">0</div>
  </div>

  <div id="breathWrap" class="hidden">
    <div class="breath-label">屏息</div>
    <div class="breath-bar"><i id="breathFill"></i></div>
  </div>

  <div id="objective">
    <div class="obj-title" id="objTitle">第一章</div>
    <div class="obj-text" id="objText"></div>
  </div>

  <div id="invBar"></div>
  <div id="toastStack"></div>
  <div id="whisper"></div>

  <div id="hintChip" class="hidden">按 <b>H</b> 燃香平心 · <b>J</b> 翻簿 · <b>TAB</b> 囊中物</div>
</div>

<!-- ============ 对话 ============ -->
<div id="dialog" class="hidden">
  <div class="dlg-portrait" id="dlgPortrait"><span id="dlgPortraitGlyph">嬿</span></div>
  <div class="dlg-body">
    <div class="dlg-name" id="dlgName"></div>
    <div class="dlg-text" id="dlgText"></div>
    <div class="dlg-choices" id="dlgChoices"></div>
  </div>
</div>

<!-- ============ 谜题面板容器 ============ -->
<div id="panelRoot" class="hidden"><div id="panelInner"></div></div>

<!-- ============ 日志/簿 ============ -->
<div id="journal" class="hidden">
  <div class="jr-head">
    <h2>引魂簿</h2>
    <button id="jrClose">合上 [J]</button>
  </div>
  <div class="jr-cols">
    <div><h3>所求</h3><ul id="jrGoals"></ul></div>
    <div><h3>所见所闻</h3><ul id="jrNotes"></ul></div>
    <div><h3>囊中物</h3><ul id="jrItems"></ul></div>
  </div>
</div>

<!-- ============ 标题 ============ -->
<div id="title">
  <div class="t-fog"></div>
  <div class="t-lantern l1"></div>
  <div class="t-lantern l2"></div>
  <div class="t-frame">
    <div class="t-seal">壹</div>
    <h1 class="t-main">引魂宅</h1>
    <div class="t-sub">红 妆 劫</div>
    <p class="t-blurb">
      民国十七年秋，你在槐宅门外醒来。<br>
      宅中今夜要办一桩冥婚，聘的是一位<b>从未谋面的活人</b>——你。<br>
      十道机关，六礼已成其五。天一亮，盖头就要落到你头上。
    </p>
    <div class="t-diff" id="diffPick">
      <button class="dbtn" data-diff="normal"><b>夜探</b><i>可循迹而行</i></button>
      <button class="dbtn on" data-diff="hard"><b>凶宅</b><i>阴气侵蚀 · 无指引</i></button>
      <button class="dbtn" data-diff="nightmare"><b>夺舍</b><i>她一直在看着你</i></button>
    </div>
    <div class="t-acts">
      <button id="btnStart" class="tbtn main">推 门 而 入</button>
      <button id="btnContinue" class="tbtn ghost hidden">续 前 缘</button>
    </div>
    <div class="t-notice">
      本作含惊吓、幽闭与民俗恐怖元素，请酌情游玩。<br>
      建议戴耳机、关灯。所有女性角色均为成年人设，魅惑止于氛围与暗示，不含露骨内容。<br>
      <span class="kbd">WASD</span> 行走 · <span class="kbd">Shift</span> 疾走 · <span class="kbd">Ctrl</span> 屏息 · <span class="kbd">E</span> 交互 · <span class="kbd">Tab</span> 囊中物 · <span class="kbd">J</span> 簿 · <span class="kbd">Esc</span> 释义
    </div>
  </div>
</div>

<!-- ============ 幕间 ============ -->
<div id="curtain" class="hidden">
  <div class="cu-text" id="curtainText"></div>
</div>

<!-- ============ 死亡/结局 ============ -->
<div id="endscreen" class="hidden">
  <div class="en-kicker" id="enKicker"></div>
  <h2 class="en-title" id="enTitle"></h2>
  <p class="en-body" id="enBody"></p>
  <div class="en-acts">
    <button id="btnResume" class="tbtn main">自 香炉前 醒来</button>
    <button id="btnQuit" class="tbtn ghost">回到门外</button>
  </div>
</div>

<!-- ============ 暂停释义 ============ -->
<div id="pause" class="hidden">
  <div class="pa-box">
    <h3>引魂宅 · 释义</h3>
    <ul class="pa-list">
      <li><b>WASD</b> 行走 · <b>Shift</b> 疾走（脚步响亮，她会听见）</li>
      <li><b>E</b> 查看 / 拾取 / 使用 · 手持物时对目标使用</li>
      <li><b>Ctrl</b> 屏息 —— 藏身时她走近，屏息可躲过</li>
      <li><b>H</b> 于香炉前燃香，平定阴气，方圆之内她不敢入</li>
      <li><b>Tab</b> 囊中物 · <b>J</b> 引魂簿（线索与所求）</li>
      <li><b>魂灯</b> 即你的心智。灯灭，你便不再是自己</li>
    </ul>
    <div class="pa-acts">
      <button id="btnResumePlay" class="tbtn main">继 续</button>
      <button id="btnSave" class="tbtn ghost">刻 印（存档）</button>
      <button id="btnTitleBack" class="tbtn ghost">回 门 外</button>
    </div>
  </div>
</div>

<script type="module" src="./src/main.js"></script>
<noscript>本作需要 JavaScript 与 WebGL。</noscript>
</body>
</html>

/* =========================================================
   引魂宅 · 红妆劫 — 中式恐怖 UI
   ========================================================= */
:root{
  --ink:#0a0807;
  --paper:#d8c9a6;
  --paper-dim:#b3a17c;
  --blood:#8c1611;
  --blood-bright:#c8201a;
  --gold:#c9a24a;
  --ghost:#8fd4d0;
  --serif:"KaiTi","STKaiti","Kaiti SC","SimSun","Noto Serif SC",serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;overflow:hidden;background:#000;color:var(--paper);
  font-family:var(--serif);-webkit-font-smoothing:antialiased;cursor:none}
body.cursor-on{cursor:default}
canvas#scene{position:fixed;inset:0;display:block;width:100%;height:100%}
.hidden{display:none!important}

/* --- 胶片颗粒 + 暗角 --- */
#grain{position:fixed;inset:-50%;pointer-events:none;z-index:5;opacity:.16;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='140' height='140'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3'/><feColorMatrix type='saturate' values='0'/></filter><rect width='140' height='140' filter='url(%23n)' opacity='.55'/></svg>");
  animation:grainShift 1.1s steps(4) infinite;mix-blend-mode:overlay}
@keyframes grainShift{
  0%{transform:translate(0,0)}25%{transform:translate(-3%,2%)}
  50%{transform:translate(2%,-3%)}75%{transform:translate(-2%,-2%)}100%{transform:translate(0,0)}}
#bloodVig{position:fixed;inset:0;pointer-events:none;z-index:6;opacity:0;transition:opacity .5s;
  background:radial-gradient(ellipse at center,transparent 34%,rgba(120,8,6,.55) 78%,rgba(40,0,0,.92) 100%)}
#bloodVig.on{opacity:1}

/* ============ HUD ============ */
#hud{position:fixed;inset:0;z-index:10;pointer-events:none}
#crosshair{position:absolute;left:50%;top:50%;width:14px;height:14px;transform:translate(-50%,-50%);
  opacity:.45;transition:opacity .2s,transform .2s}
#crosshair::before,#crosshair::after{content:"";position:absolute;background:var(--paper-dim)}
#crosshair::before{left:6px;top:0;width:2px;height:14px}
#crosshair::after{top:6px;left:0;height:2px;width:14px}
#crosshair.hot{opacity:1;transform:translate(-50%,-50%) scale(1.35)}
#crosshair.hot::before,#crosshair.hot::after{background:var(--gold)}

#prompt{position:absolute;left:50%;top:56%;transform:translateX(-50%);
  display:none;align-items:center;gap:10px;padding:7px 16px;
  background:linear-gradient(180deg,rgba(12,9,8,.86),rgba(12,9,8,.66));
  border:1px solid rgba(201,162,74,.42);letter-spacing:.16em;font-size:15px;
  box-shadow:0 0 22px rgba(0,0,0,.7)}
#prompt.on{display:flex}
#promptKey{display:grid;place-items:center;width:22px;height:22px;font-size:12px;color:#120d0b;
  background:var(--gold);font-family:system-ui,sans-serif;font-weight:700}
#promptText{color:var(--paper)}

/* 魂灯 = 理智 */
#soulLamp{position:absolute;left:26px;bottom:26px;width:200px}
.lamp-label{font-size:13px;letter-spacing:.4em;color:var(--paper-dim);margin-bottom:5px}
.lamp-bar{height:6px;background:rgba(216,201,166,.14);border:1px solid rgba(216,201,166,.28);position:relative;overflow:hidden}
.lamp-bar i{position:absolute;inset:0 100% 0 0;background:linear-gradient(90deg,#5a1108,var(--blood-bright),#ffb45a);
  transition:right .35s cubic-bezier(.2,.8,.2,1)}
.lamp-num{font-size:11px;color:#6d604d;margin-top:4px;letter-spacing:.2em}
#soulLamp.danger .lamp-label{color:var(--blood-bright);animation:pulseT 1s infinite}
@keyframes pulseT{50%{opacity:.35}}

/* 屏息 */
#breathWrap{position:absolute;left:50%;bottom:120px;transform:translateX(-50%);width:170px;text-align:center}
.breath-label{font-size:12px;letter-spacing:.5em;color:var(--ghost);margin-bottom:4px}
.breath-bar{height:4px;background:rgba(143,212,208,.16);border:1px solid rgba(143,212,208,.35);overflow:hidden}
.breath-bar i{display:block;height:100%;width:100%;background:var(--ghost)}

/* 所求 */
#objective{position:absolute;right:26px;top:26px;max-width:300px;text-align:right;
  border-right:2px solid rgba(201,162,74,.45);padding-right:14px}
.obj-title{font-size:12px;letter-spacing:.45em;color:var(--gold);opacity:.8}
.obj-text{font-size:15px;line-height:1.7;color:#cbbda0;margin-top:4px;text-shadow:0 2px 10px #000}

/* 囊中物 */
#invBar{position:absolute;left:50%;bottom:26px;transform:translateX(-50%);display:flex;gap:8px}
.slot{width:52px;height:52px;border:1px solid rgba(216,201,166,.22);
  background:linear-gradient(180deg,rgba(10,8,7,.78),rgba(20,14,12,.58));
  display:grid;place-items:center;position:relative;pointer-events:auto;cursor:pointer;transition:.18s}
.slot:hover{border-color:var(--gold);transform:translateY(-3px)}
.slot.sel{border-color:var(--blood-bright);box-shadow:0 0 16px rgba(200,32,26,.5) inset,0 0 10px rgba(200,32,26,.35)}
.slot .g{font-size:23px;line-height:1;filter:drop-shadow(0 0 5px rgba(0,0,0,.9))}
.slot .n{position:absolute;bottom:-17px;left:50%;transform:translateX(-50%);font-size:10px;white-space:nowrap;color:#8d7f66;opacity:0;transition:.2s}
.slot:hover .n{opacity:1}

/* 提示条 */
#hintChip{position:absolute;left:50%;top:20px;transform:translateX(-50%);font-size:12px;letter-spacing:.16em;
  color:#7d6f58;background:rgba(8,6,5,.6);padding:5px 14px;border:1px solid rgba(216,201,166,.14)}
#hintChip b{color:var(--gold)}

/* 飘字 */
#toastStack{position:absolute;left:50%;bottom:180px;transform:translateX(-50%);display:flex;flex-direction:column;gap:6px;align-items:center}
.toast{font-size:15px;letter-spacing:.14em;color:var(--paper);background:rgba(8,6,5,.82);
  padding:7px 20px;border-left:2px solid var(--gold);border-right:2px solid var(--gold);
  animation:toastIn .4s ease-out,toastOut .5s 2.6s forwards;text-shadow:0 1px 4px #000}
.toast.bad{color:#e07a72;border-color:var(--blood-bright)}
.toast.good{color:#e8d7a0}
@keyframes toastIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
@keyframes toastOut{to{opacity:0;transform:translateY(-10px)}}

/* 耳边低语 */
#whisper{position:absolute;left:50%;top:40%;transform:translate(-50%,-50%);width:60%;text-align:center;
  font-size:20px;line-height:2;color:rgba(143,212,208,0);letter-spacing:.3em;
  text-shadow:0 0 24px rgba(143,212,208,.5);transition:color 1.4s;pointer-events:none}
#whisper.on{color:rgba(198,236,233,.72)}

/* ============ 对话 ============ */
#dialog{position:absolute;left:50%;bottom:96px;transform:translateX(-50%);z-index:22;width:min(920px,92vw);
  display:flex;gap:16px;pointer-events:auto;
  background:linear-gradient(180deg,rgba(11,8,7,.94),rgba(22,13,12,.9));
  border:1px solid rgba(201,162,74,.34);padding:16px 20px;
  box-shadow:0 18px 60px rgba(0,0,0,.85)}
.dlg-portrait{flex:0 0 88px;height:112px;display:grid;place-items:center;
  background:radial-gradient(circle at 50% 32%,#3a1010,#0c0605);
  border:1px solid rgba(201,162,74,.5)}
.dlg-portrait span{font-size:46px;color:var(--blood-bright);text-shadow:0 0 18px rgba(200,32,26,.7)}
.dlg-name{font-size:14px;letter-spacing:.4em;color:var(--gold);margin-bottom:8px}
.dlg-text{font-size:18px;line-height:1.95;color:#ded0b2;min-height:70px;text-shadow:0 2px 8px #000}
.dlg-text .cursor{color:var(--blood-bright);animation:blink .5s steps(2) infinite}
@keyframes blink{50%{opacity:0}}
.dlg-choices{display:flex;flex-direction:column;gap:6px;margin-top:12px}
.choice{text-align:left;font-family:var(--serif);font-size:15px;color:#bfae8c;background:none;
  border:1px solid rgba(216,201,166,.2);padding:7px 14px;cursor:pointer;letter-spacing:.1em;transition:.16s}
.choice:hover{color:#fff;border-color:var(--blood-bright);background:rgba(140,22,17,.2);padding-left:22px}
.choice.risk{border-style:dashed;border-color:rgba(200,32,26,.5)}
.choice.risk::after{content:" · 险";color:var(--blood-bright);font-size:12px}

/* ============ 谜题面板 ============ */
#panelRoot{position:fixed;inset:0;z-index:30;display:grid;place-items:center;pointer-events:auto;
  background:rgba(3,2,2,.82);backdrop-filter:blur(3px);cursor:default}
#panelInner{max-height:92vh;overflow:auto;padding:26px 30px 22px;position:relative;
  background:linear-gradient(155deg,#efe2c2,#d6c39a 60%,#c6b184);
  color:#20160e;border:2px solid #6a4a24;
  box-shadow:0 0 0 6px #1a100a,0 30px 90px rgba(0,0,0,.9),inset 0 0 60px rgba(120,90,40,.28);
  font-family:var(--serif)}
#panelInner::before{content:"";position:absolute;inset:8px;border:1px solid rgba(106,74,36,.35);pointer-events:none}
.p-title{font-size:26px;letter-spacing:.3em;text-align:center;color:#5a1310;margin-bottom:4px;font-weight:700}
.p-sub{font-size:13px;text-align:center;color:#6d5a3c;letter-spacing:.15em;margin-bottom:18px;line-height:1.8}
.p-close{position:absolute;right:14px;top:12px;font-family:var(--serif);font-size:14px;color:#5b4324;
  background:none;border:1px solid #8a6a3c;padding:3px 11px;cursor:pointer;letter-spacing:.2em}
.p-close:hover{background:#5a1310;color:#f0e3c6}
.p-foot{display:flex;gap:12px;justify-content:center;margin-top:20px}
.pbtn{font-family:var(--serif);font-size:17px;letter-spacing:.3em;padding:9px 30px;cursor:pointer;
  background:#1e150e;color:var(--paper);border:1px solid #8a6a3c;transition:.18s}
.pbtn:hover{background:var(--blood);border-color:var(--blood-bright);color:#fff}
.pbtn.sm{font-size:14px;padding:6px 16px;letter-spacing:.15em}
.p-note{font-size:14px;color:#4a3a22;text-align:center;min-height:22px;margin-top:10px;letter-spacing:.1em}
.p-note.err{color:#8c1611;font-weight:700}
.shake{animation:shk .38s}
@keyframes shk{10%,90%{transform:translateX(-4px)}30%,70%{transform:translateX(6px)}50%{transform:translateX(-8px)}}
.ink-card{background:rgba(30,21,14,.08);border:1px solid rgba(90,19,16,.3);padding:12px 16px;
  font-size:16px;line-height:2;color:#2b1d10;white-space:pre-wrap;margin-bottom:14px;
  box-shadow:inset 0 0 24px rgba(120,90,40,.16)}
.ink-card b{color:#7d1108}

/* --- 通用可选格 --- */
.grid{display:grid;gap:10px;justify-content:center}
.cell{width:78px;height:96px;display:grid;place-items:center;cursor:pointer;position:relative;
  background:linear-gradient(180deg,#f4e9cf,#d9c8a0);border:1px solid #8a6a3c;transition:.16s;
  font-size:30px;color:#2b1d10}
.cell:hover{transform:translateY(-3px);box-shadow:0 6px 16px rgba(0,0,0,.3)}
.cell.sel{border:2px solid var(--blood);box-shadow:0 0 14px rgba(140,22,17,.5)}
.cell .cap{position:absolute;bottom:4px;font-size:11px;letter-spacing:.2em;color:#6d5a3c}
.cell.done{opacity:.5;cursor:default}

/* 五行灯 */
.wuxing{display:grid;grid-template-columns:repeat(3,108px);grid-template-rows:repeat(3,108px);gap:8px;justify-content:center}
.wl{position:relative;display:grid;place-items:center;border:1px dashed rgba(90,74,36,.4);background:rgba(255,246,220,.35)}
.wl .dir{position:absolute;top:3px;font-size:11px;letter-spacing:.2em;color:#6d5a3c}
.wl .lan{width:52px;height:66px;border-radius:50%/38%;background:#4a3a2a;opacity:.4;position:relative;transition:.2s;
  border:2px solid #2b1d10}
.wl .lan::after{content:"";position:absolute;left:50%;bottom:-11px;width:2px;height:11px;background:#7a5a2c;transform:translateX(-50%)}
.wl.lit .lan{opacity:1;box-shadow:0 0 26px 6px currentColor}
.wl:hover .lan{transform:scale(1.08)}

/* 牌位 */
.tblants{display:flex;gap:8px;justify-content:center;align-items:flex-end}
.tb{width:60px;height:104px;background:linear-gradient(180deg,#3f2a17,#241708);color:#e3cf9c;
  border:1px solid #7a5a2c;cursor:pointer;display:grid;place-items:center;font-size:14px;line-height:1.15;
  writing-mode:vertical-rl;padding:6px 2px;transition:.16s;box-shadow:0 4px 10px rgba(0,0,0,.35)}
.tb:hover{transform:translateY(-4px)}
.tb.slot{background:rgba(36,23,8,.12);border:1px dashed #8a6a3c;color:#8a6a3c;min-height:104px}
.tb.picked{outline:2px solid var(--blood)}

/* 光路 */
.mirror-grid{display:grid;gap:2px;background:#1b120a;padding:8px;justify-content:center}
.mcell{width:44px;height:44px;position:relative;background:#2a1d10}
.mcell.beam::after{content:"";position:absolute;left:50%;top:50%;width:78%;height:2px;background:#ffd479;
  transform:translate(-50%,-50%);box-shadow:0 0 10px #ffb43c}
.mcell .mir{position:absolute;inset:0;display:grid;place-items:center;color:#bfe6e2;font-size:22px;cursor:pointer}
.mcell .mir:hover{color:#fff}

/* 工尺谱 */
.notes{display:flex;gap:10px;justify-content:center;margin:10px 0}
.note{width:64px;height:80px;background:#f6ecd2;border:1px solid #8a6a3c;cursor:pointer;display:grid;place-items:center;
  font-size:26px;color:#2b1d10;position:relative;transition:.14s}
.note:hover{background:#fff6dd;transform:translateY(-3px)}
.note.on{background:var(--blood);color:#ffe9c9;border-color:var(--blood-bright)}
.track{display:flex;gap:6px;justify-content:center;margin-top:14px}
.pip{width:38px;height:52px;border:1px solid #8a6a3c;background:rgba(255,255,255,.3);display:grid;place-items:center;font-size:20px}

/* 符咒 */
#talCanvas{display:block;background:#f7edd4;border:1px solid #8a6a3c;cursor:crosshair;touch-action:none}
.ghost-stroke{position:absolute;inset:0;pointer-events:none;opacity:0;transition:opacity .3s}

/* 纸人 */
.pdolls{display:flex;gap:14px;justify-content:center}
.pdoll{width:96px;padding:8px;border:1px solid #8a6a3c;background:rgba(255,246,220,.5);cursor:pointer;text-align:center;transition:.16s}
.pdoll:hover{transform:translateY(-4px);box-shadow:0 8px 18px rgba(0,0,0,.28)}
.pdoll .body{height:104px;margin:0 auto 6px;width:64px;background:var(--c,#9a8a6a);
  clip-path:polygon(30% 0,70% 0,86% 22%,78% 100%,22% 100%,14% 22%);border:1px solid rgba(0,0,0,.3);position:relative}
.pdoll .body::before{content:"";position:absolute;left:50%;top:-2px;width:34px;height:34px;border-radius:50%;
  transform:translateX(-50%);background:#f2e3c4;border:1px solid rgba(0,0,0,.25)}
.pdoll .lbl{font-size:12px;letter-spacing:.2em}
.chips{display:flex;gap:8px;justify-content:center;margin-top:12px;flex-wrap:wrap}
.chip{padding:5px 14px;border:1px solid #8a6a3c;font-size:14px;cursor:pointer;background:rgba(255,255,255,.25)}
.chip.on{background:var(--blood);color:#fff}

/* 杆秤 */
.scale-wrap{width:620px;height:190px;position:relative;background:rgba(255,246,220,.3);border:1px solid #8a6a3c}
#scaleBeam{position:absolute;left:20px;right:20px;top:78px;height:8px;background:linear-gradient(90deg,#7a5a2c,#a9853f);
  transform-origin:50% 50%;transition:transform .6s cubic-bezier(.3,1.4,.4,1)}
.pivot{position:absolute;left:50%;top:86px;width:0;height:0;border-left:14px solid transparent;
  border-right:14px solid transparent;border-top:34px solid #4a3a2a;transform:translateX(-50%)}
