export class Input{
  constructor(canvas){
    this.canvas=canvas;
    this.keys=new Set();
    this.mouse={dx:0,dy:0,left:false,right:false,wheel:0};
    this.locked=false;
    this.sensitivity=0.0022;
    this.yaw=0;this.pitch=0;
    this._consumers=[];
    this._bind();
  }
  _bind(){
    window.addEventListener('keydown',e=>{
      if(e.repeat)return;
      const k=e.code;
      this.keys.add(k);
      if(k==='Tab'||k==='Space')e.preventDefault();
      this._fire('keydown',k,e);
    });
    window.addEventListener('keyup',e=>this.keys.delete(e.code));
    window.addEventListener('blur',()=>{this.keys.clear();this.mouse.dx=this.mouse.dy=0;});
    this.canvas.addEventListener('mousedown',e=>{
      if(!this.locked){this.requestLock();return;}
      if(e.button===0){this.mouse.left=true;this._fire('click',e);}
      if(e.button===2){this.mouse.right=true;this._fire('rclick',e);}
    });
    window.addEventListener('mouseup',e=>{if(e.button===0)this.mouse.left=false;if(e.button===2)this.mouse.right=false;});
    this.canvas.addEventListener('contextmenu',e=>e.preventDefault());
    window.addEventListener('mousemove',e=>{
      if(!this.locked)return;
      this.mouse.dx+=e.movementX||0;this.mouse.dy+=e.movementY||0;
    });
    window.addEventListener('wheel',e=>{if(this.locked)this.mouse.wheel+=Math.sign(e.deltaY);},{passive:true});
    document.addEventListener('pointerlockchange',()=>{
      this.locked=document.pointerLockElement===this.canvas;
      document.body.classList.toggle('cursor-on',!this.locked);
      this._fire('lockchange',this.locked);
    });
  }
  requestLock(){ if(document.pointerLockElement!==this.canvas) this.canvas.requestPointerLock?.(); }
  exitLock(){ if(document.pointerLockElement===this.canvas) document.exitPointerLock(); }
  down(...codes){return codes.some(c=>this.keys.has(c));}
  on(ev,fn){this._consumers.push({ev,fn});return()=>this._consumers=this._consumers.filter(c=>c.fn!==fn);}
  _fire(ev,a,b){for(const c of this._consumers)if(c.ev===ev)c.fn(a,b);}
  /** 消费累积的鼠标增量 */
  readLook(){const d={dx:this.mouse.dx,dy:this.mouse.dy};this.mouse.dx=0;this.mouse.dy=0;return d;}
  readWheel(){const w=this.mouse.wheel;this.mouse.wheel=0;return w;}
  /** 一次性按键 */
  pressed(code){ if(this.keys.has(code)){ if(!this._seen)this._seen=new Set();
      if(this._seen.has(code))return false; this._seen.add(code); return true;} 
    if(this._seen)this._seen.delete(code); return false; }
}

import * as THREE from 'three';

const VERT=`
varying vec2 vUv;
void main(){vUv=uv;gl_Position=vec4(position.xy,0.0,1.0);}`;

const FRAG=`
precision highp float;
varying vec2 vUv;
uniform sampler2D tDiffuse;
uniform float uTime,uDread,uFlash,uHurt,uBreath,uCold,uVig;
uniform vec2 uRes;

float hash(vec2 p){p=fract(p*vec2(123.34,456.21));p+=dot(p,p+34.56);return fract(p.x*p.y);}

vec3 grade(vec3 c,float dread){
  float l=dot(c,vec3(.299,.587,.114));
  vec3 mono=vec3(l);
  c=mix(mono,c,1.0-dread*0.34-0.18);            // 随恐惧褪色
  c=max(vec3(0.0),c-0.014);
  // 冷青阴影 + 残红高光
  float shadow=1.0-smoothstep(0.05,0.55,l);
  float hi=smoothstep(0.55,1.0,l);
  c+=vec3(-0.02,0.028,0.032)*shadow*(0.6+dread*0.9);
  c=mix(c,c*vec3(1.16,0.62,0.55),hi*0.34);
  // 伽马压缩黑位
  c=pow(max(c,vec3(0.0)),vec3(1.06));
  return c;
}

void main(){
  vec2 uv=vUv;
  vec2 cc=uv-0.5;
  float r2=dot(cc,cc);
  // 桶形畸变：恐惧越高越"呼吸"
  float wob=1.0+sin(uTime*1.7)*0.004*uBreath;
  float dist=1.0+ r2*(0.035+uDread*0.11)*wob;
  uv=cc*dist+0.5;

  float ca=(0.0012+uDread*0.0055+uHurt*0.012)*(0.35+r2*3.0);
  vec3 col;
  col.r=texture2D(tDiffuse,(uv+vec2(ca,-ca*0.4))).r;
  col.g=texture2D(tDiffuse,uv).g;
  col.b=texture2D(tDiffuse,(uv-vec2(ca,ca*0.4))).b;

  col=grade(col,uDread);

  // 冷雾层（地气）
  col=mix(col,col*vec3(0.86,1.0,1.02)+vec3(0.0,0.012,0.016)*smoothstep(0.65,0.0,uv.y),uCold*0.5);

  // 扫描/撕扯（闪现时）
  if(uFlash>0.001){
    float band=step(0.5,hash(vec2(floor(uv.y*90.0),floor(uTime*22.0))));
    col+=vec3(0.10,0.14,0.13)*band*uFlash;
    col*=1.0-uFlash*0.28*hash(vec2(uTime,uv.y*40.0));
    float she=smoothstep(0.4,1.0,hash(vec2(floor(uTime*14.0),3.0)))*uFlash;
    col=mix(col,vec3(0.9,0.95,0.98),she*0.5*(1.0-smoothstep(0.0,0.35,abs(uv.y-0.55))));
  }

  // 血雾
  col=mix(col,col*vec3(1.25,0.28,0.24),uHurt*0.55);

  // 颗粒
  float g=hash(uv*uRes*0.5+vec2(uTime*60.0,-uTime*37.0));
  col+=(g-0.5)*(0.035+uDread*0.055);

  // 暗角
  float vig=smoothstep(0.86,0.16,r2*2.1);
  col*=mix(1.0,vig,0.82*uVig);

  // 边缘吞黑（低理智）
  col*=1.0-uDread*0.35*smoothstep(0.18,0.62,r2*2.0);

  gl_FragColor=vec4(col,1.0);
}`;

export class PostFX{
  constructor(renderer){
    this.renderer=renderer;
    this.rt=new THREE.WebGLRenderTarget(1,1,{minFilter:THREE.LinearFilter,magFilter:THREE.LinearFilter,
      type:THREE.HalfFloatType,depthBuffer:true,stencilBuffer:false});
    this.scene=new THREE.Scene();
    this.cam=new THREE.OrthographicCamera(-1,1,1,-1,0,1);
    this.mat=new THREE.ShaderMaterial({
      vertexShader:VERT,fragmentShader:FRAG,depthTest:false,depthWrite:false,
      uniforms:{tDiffuse:{value:this.rt.texture},uTime:{value:0},uDread:{value:0},
        uFlash:{value:0},uHurt:{value:0},uBreath:{value:0},uCold:{value:0},uVig:{value:1},
        uRes:{value:new THREE.Vector2(1,1)}}
    });
    const quad=new THREE.Mesh(new THREE.PlaneGeometry(2,2),this.mat);
    quad.frustumCulled=false;this.scene.add(quad);
    this.dread=0;this.flash=0;this.hurt=0;this.cold=0;
  }
  setSize(w,h,dpr){
    this.rt.setSize(Math.floor(w*dpr),Math.floor(h*dpr));
    this.mat.uniforms.uRes.value.set(Math.floor(w*dpr),Math.floor(h*dpr));
  }
  render(scene,camera,t){
    const u=this.mat.uniforms;
    u.uTime.value=t;
    u.uDread.value=this.dread;
    u.uFlash.value=this.flash;
    u.uHurt.value=this.hurt;
    u.uCold.value=this.cold;
    this.renderer.setRenderTarget(this.rt);
    this.renderer.render(scene,camera);
    this.renderer.setRenderTarget(null);
    this.renderer.render(this.scene,this.cam);
    this.flash*=0.90; this.hurt*=0.955;
  }
  scream(amount=1){this.flash=Math.min(1,this.flash+amount);}
}

export const clamp=(v,a,b)=>v<a?a:v>b?b:v;
export const lerp=(a,b,t)=>a+(b-a)*t;
export const smoothstep=(t)=>t*t*(3-2*t);
export const rand=(a=1,b)=>b===undefined?Math.random()*a:a+Math.random()*(b-a);
export const randInt=(a,b)=>Math.floor(rand(a,b+1));
export const pick=(arr)=>arr[Math.floor(Math.random()*arr.length)];
export const shuffle=(arr)=>{const a=arr.slice();for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;};
export const dist2=(ax,az,bx,bz)=>{const dx=ax-bx,dz=az-bz;return Math.hypot(dx,dz);};
export const now=()=>performance.now()/1000;

export const uid=(p='id')=>p+'_'+Math.random().toString(36).slice(2,9);

/** 稳定伪随机（同一 seed 同一序列），用于每次进入场景物件一致 */
export function makeRng(seed=1){let s=seed>>>0||1;return()=>{s^=s<<13;s>>>=0;s^=s>>17;s^=s<<5;s>>>=0;return s/4294967296;};}

/** AABB 与圆 的最小位移修正 */
export function pushOutCircle(cx,cz,r,box){
  const nx=clamp(cx,box.minX,box.maxX), nz=clamp(cz,box.minZ,box.maxZ);
  let dx=cx-nx, dz=cz-nz; const d2=dx*dx+dz*dz;
  if(d2>r*r) return null;                 // 圆心在盒外且不相交
  if(d2>1e-9){
    const d=Math.sqrt(d2), k=(r-d)/d;
    return {x:dx*k, z:dz*k};
  }
  // 圆心在盒内：沿最近面推出
  const toL=cx-box.minX, toR=box.maxX-cx, toB=cz-box.minZ, toF=box.maxZ-cz;
  const m=Math.min(toL,toR,toB,toF);
  if(m===toL) return {x:-(toL+r),z:0};
  if(m===toR) return {x:toR+r,z:0};
  if(m===toB) return {x:0,z:-(toB+r)};
  return {x:0,z:toF+r};
}

export function fmt(n,pad=2){return String(n).padStart(pad,'0');}

export function debounce(fn,ms=200){let t;return(...a)=>{clearTimeout(t);t=setTimeout(()=>fn(...a),ms);};}

/** 逐字打字机（返回可取消句柄） */
export function typeWrite(el,text,{speed=34,onDone=null,onTick=null}={}){
  let i=0,alive=true;el.textContent='';
  const step=()=>{
    if(!alive)return;
    el.textContent=text.slice(0,++i);
    if(onTick)onTick(i);
    if(i<text.length){const ch=text[i];const p=(ch==='，'||ch==='。'||ch==='…'||ch==='；')?speed*5.5:speed;setTimeout(step,p);}
    else if(onDone)onDone();
  };
  setTimeout(step,10);
  return {skip(){if(!alive)return;alive=false;el.textContent=text;onDone&&onDone();},
          kill(){alive=false;}};
}

