    if(d>i.radius+(i.kind==='censer'?1.4:1.1))continue;
    const dot=(dx*_dir.x+dy*_dir.y+dz*_dir.z)/(d||1);
    const ang=Math.acos(Math.max(-1,Math.min(1,dot)));
