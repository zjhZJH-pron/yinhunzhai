      const c=new THREE.Mesh(box(b-a+.4,.24,thick+.2),MAT.tile);
      c.position.set((a+b)/2,h+.12,z);root.add(c);
    }
    return {a,b,z,h};
  }
  /** 纵墙（位于 x=const，沿 z 从 a 到 b） */
  function wallX(x,a,b,h,{openings=[],mat='plaster',cap=true,thick=TH}={}){
