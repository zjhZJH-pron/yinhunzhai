      app.hud.say({who:'苏婉娘',glyph:'嬿',
        text:'「你喜欢大红么？」声音就从你耳后。\n「我量过你了。井水凉的量法，量得最准。」\n嫁衣在无风的院子里自己翻了个袖口。',speed:26});
