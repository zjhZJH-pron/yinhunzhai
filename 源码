import {createNPCs} from './game/npc.js';
import {STORY,curtain,startGame,askHint} from './game/story.js';

const STEP=.62, EYE=1.66, RAD=.34;

export class App{
  constructor(){
    this.canvas=document.getElementById('scene');
    this.renderer=new THREE.WebGLRenderer({canvas:this.canvas,antialias:false,
      powerPreference:'high-performance',stencil:false});
    this.renderer.setPixelRatio(Math.min(devicePixelRatio,1.5));
    this.renderer.setSize(innerWidth,innerHeight);
    this.renderer.shadowMap.enabled=true;
    this.renderer.shadowMap.type=THREE.PCFSoftShadowMap;
    this.renderer.toneMapping=THREE.ACESFilmicToneMapping;
    this.renderer.toneMappingExposure=1.45;
    this.renderer.outputColorSpace=THREE.SRGBColorSpace;

    this.scene=new THREE.Scene();
    this.scene.background=new THREE.Color(0x07090b);
    this.camera=new THREE.PerspectiveCamera(74,innerWidth/innerHeight,.06,90);
    this.camera.rotation.order='YXZ';
    this.scene.add(this.camera);

    this.parts=new Parts();
    this.audio=new AudioEngine();
    this.postfx=new PostFX(this.renderer);
    this.input=new Input(this.canvas);
    this.hud=new HUD(this);
    this.panels=new Panels(this);

    this.colliders=[];
    this.interactives=[];
    this.hideSpots=[];
    this.targets=[];
    this.state=null;
    this.player={pos:new THREE.Vector3(0,0,14.9),vel:new THREE.Vector3(),feet:0,vy:0,
      yaw:Math.PI,pitch:-.02,breath:1,hidden:false,holding:false,nearGhost:0};
    this.running=false;this.paused=false;this.uiOpen=false;this.dead=false;
    this.t=0;this.dt=0;this.fps=60;this.shakeT=0;this.noiseLevel=0;
    this.diffNightmare=false;this.torch=null;this.torchOn=false;
    this.safeUntil=0;this.safeAt=null;this.bobX=0;this.bobY=0;this.bobT=0;this._stepT=0;

    addEventListener('resize',()=>this.resize());
    this.resize();
  }
  resize(){
    const w=innerWidth,h=innerHeight;
    const dpr=Math.min(devicePixelRatio,1.5);
    this.renderer.setPixelRatio(dpr);
    this.renderer.setSize(w,h);
    this.camera.aspect=w/h;this.camera.updateProjectionMatrix();
    this.postfx.setSize(w,h,dpr);
  }
  syncUi(){
    this.uiOpen=this.paused||this.dead||this.panels.isOpen||this.hud.journalOpen||this.hud.dialogOpen;
  }
  boot(diff='hard'){
    this.diffNightmare=diff==='nightmare';
    this.state=new GameState(diff);
    this.manor=buildManor(this);
    registerInteractives(this);
    this.npc=createNPCs(this);
    startGame(this,false);
    this.hud.renderInv();this.hud.updateJournal();
    this.bindUI();
    this.clock=new THREE.Clock();
    if(!this.running){this.running=true;this.loop();}
  }
  load(){
    const raw=localStorage.getItem(SAVE_KEY);if(!raw)return false;
    try{
      this.state=GameState.deserialize(raw);
      this.manor=buildManor(this);
      registerInteractives(this);
      this.npc=createNPCs(this);
      startGame(this,true);
      const cp=this.state.checkpoint;
      if(cp&&cp.pos){this.player.pos.set(cp.pos[0],0,cp.pos[2]);
        this.player.feet=cp.pos[1]||0;this.player.yaw=cp.yaw??Math.PI;}
      this.hud.renderInv();this.hud.updateJournal();
      this.bindUI();
      this.clock=new THREE.Clock();
      if(!this.running){this.running=true;this.loop();}
      return true;
    }catch(e){console.warn('[load] ',e);return false;}
  }
  save(){
    if(!this.state)return;
    const p=this.player;
    this.state.checkpoint={pos:[p.pos.x,p.feet,p.pos.z],yaw:p.yaw,room:this.room().name};
    try{localStorage.setItem(SAVE_KEY,this.state.serialize());this.hud.toast('已刻印 · 存档于本地','good');}
    catch(e){this.hud.toast('存不下来：'+e.message,'bad');}
  }
  room(){
    const p=this.player.pos;
    for(const r of Object.values(ROOMS)){
      if(r.hidden)continue;
      if(p.x>r.x0&&p.x<r.x1&&p.z>r.z0&&p.z<r.z1)return r;
    }
    return {id:'yard',name:'夹道'};
  }
  bindUI(){
    const I=this.input;
    I.on('keydown',code=>{
      if(this.dead){if(code==='Enter')document.getElementById('btnResume').click();return;}
      if(this.panels.isOpen&&code!=='Escape')return;
      if(this.hud.journalOpen){if(code==='KeyJ'||code==='Tab'||code==='Escape')this.hud.toggleJournal();return;}
      if(this.hud.dialogOpen){
        if(/^Digit[1-9]$/.test(code)){this.hud.pickChoice(parseInt(code.slice(-1),10)-1);return;}
        if(code==='Enter'||code==='Space'||code==='KeyE'||code==='Escape')this.hud.skipDialog();
        return;
      }
      switch(code){
        case 'KeyJ': case 'Tab': this.hud.toggleJournal();break;
        case 'Escape': this.togglePause(true);break;
        case 'KeyE': doInteract(this);break;
        case 'KeyH': this.tryIncense();break;
        case 'KeyG': askHint(this);break;
        case 'KeyF': this.toggleTorch();break;
        case 'Digit1': case 'Digit2': case 'Digit3': case 'Digit4': case 'Digit5':
          this.hud.selectInv(parseInt(code.slice(-1),10)-1);break;
        case 'KeyQ': this.hud.selectInv(-1);break;
      }
    });
    I.on('rclick',()=>this.hud.selectInv(-1));
    I.on('lockchange',locked=>{if(!locked&&!this.uiOpen)this.togglePause(true);});
  }
  togglePause(on){
    if(this.dead)return;
    this.paused=on===undefined?!this.paused:on;
    document.getElementById('pause').classList.toggle('hidden',!this.paused);
    this.syncUi();
    if(this.paused)this.input.exitLock();else this.input.requestLock();
  }
  toggleTorch(){
    if(!this.state.has('huozhe')){this.hud.toast('身上没有火折子','bad');return;}
    if(!this.torch){
      this.torch=new THREE.PointLight(0xffa44a,6,9,1.7);
      this.torch.position.set(.24,-.2,-.3);
      this.camera.add(this.torch);
    }
    this.torchOn=!this.torchOn;
    this.torch.intensity=this.torchOn?6:0;
    this.hud.toast(this.torchOn?'火折子亮了 —— 光也照得见她':'火光熄了','');
    this.audio.noiseHit({dur:.3,freq:2300,gain:.15,q:1.4});
  }
  tryIncense(){
    const S=this.state;
    const near=this.interactives.filter(i=>i.kind==='censer'&&this.distOf(i)<3.6);
    if(!near.length){this.hud.toast('此处没有香炉','bad');return;}
    if(!S.has('xiang')){this.hud.toast('无香可燃','bad');return;}
    S.take('xiang');
    near[0].use&&near[0].use();
    S.addDread(-45);
    this.audio.guzheng(196,{dur:2.2,gain:.3});this.audio.bell(2093,{dur:2.8,gain:.12});
    this.hud.toast('香燃上了。这一方地，她今夜进不来','good');
    this.safeAt=this.targetWorld(near[0]).clone();
    this.safeUntil=this.t+90;
    this.hud.pulseSafe(this.safeAt,7);
  }
  targetWorld(i){
    if(i.vec)return i.vec.clone();
    const v=new THREE.Vector3();(i.mesh||i.group).getWorldPosition(v);return v;
  }
  distOf(i){return this.camera.position.distanceTo(this.targetWorld(i));}

  /* ---------------- 移动 · 碰撞 · 视角 ---------------- */
  move(dt){
    const P=this.player,I=this.input,S=this.state;
    const {dx,dy}=I.readLook();
    const sens=I.sensitivity*(this.diffNightmare?1.15:1);
    P.yaw-=dx*sens;P.pitch-=dy*sens;
    P.pitch=Math.max(-1.3,Math.min(1.3,P.pitch));

    let mf=0,ms=0;
    if(I.down('KeyW','ArrowUp'))mf+=1;
    if(I.down('KeyS','ArrowDown'))mf-=1;
    if(I.down('KeyA','ArrowLeft'))ms-=1;
    if(I.down('KeyD','ArrowRight'))ms+=1;
    const run=I.down('ShiftLeft','ShiftRight');
    const breathKey=I.down('ControlLeft','ControlRight');
    const spd=P.hidden?1.15:run?4.4:2.4;
    const len=Math.hypot(ms,mf);
    const sinY=Math.sin(P.yaw),cosY=Math.cos(P.yaw);
    let vx=0,vz=0;
    if(len>0){
      const f=mf/len,r=ms/len;
      vx=(-sinY*f+cosY*r)*spd;
      vz=(-cosY*f-sinY*r)*spd;
    }
    const k=1-Math.exp(-dt*13);
    P.vel.x+=(vx-P.vel.x)*k;P.vel.z+=(vz-P.vel.z)*k;

    // 屏息
    if(P.hidden&&breathKey&&!P.holding)P.holding=true;
    if(!breathKey)P.holding=false;
    if(P.holding){
      P.breath-=dt*(P.nearGhost>.55?.30:P.hidden?.13:.05);
      if(P.breath<=0){P.breath=0;P.holding=false;
        this.hud.toast('憋不住了……','bad');S.addDread(5);
        this.audio.noiseHit({dur:.5,freq:880,gain:.2,q:1.2});}
    }else P.breath=Math.min(1,P.breath+dt*(P.hidden?.12:.55));
    this.hud.setBreath(P.holding?P.breath:null);

    const stepping=len>0;
    this.noiseLevel=THREE.MathUtils.lerp(this.noiseLevel,stepping?(run?1:P.hidden?.12:.5):0,dt*4);

    this.tryMove(P.vel.x*dt,0);
    this.tryMove(0,P.vel.z*dt);
    const sup=this.supportAt(P.pos.x,P.pos.z);
    P.vy-=17*dt;P.feet+=P.vy*dt;
    if(P.feet<=sup){if(P.vy<-3)this.stepSound('stone',.45);P.feet=sup;P.vy=0;}

    // 藏身
    const hid=this.nearHide();
    if(hid!==P.hidden){
      P.hidden=hid;
      this.hud.toast(hid?'你缩进阴影里。按住 [Ctrl] 屏息':'你从藏身处走了出来','');
      if(hid)this.audio.noiseHit({dur:.3,freq:620,gain:.12,q:1.5});
    }

    // 镜头
    const moving=stepping&&Math.hypot(P.vel.x,P.vel.z)>.5;
    if(moving){
      this.bobT+=dt*(run?11.2:7.4);
      const amp=(run?.04:.021)*(S.dreadN*.5+.75);
      this.bobY=Math.sin(this.bobT)*amp;
      this.bobX=Math.cos(this.bobT*.5)*amp*.75;
      if(this.t-this._stepT>(run?.35:.6)){this._stepT=this.t;this.stepSound(this.floorMat());}
    }else{
      this.bobY+=(0-this.bobY)*Math.min(1,dt*6);
      this.bobX+=(0-this.bobX)*Math.min(1,dt*6);
    }
    const shake=this.shakeT>0?this.shakeT:0;
    this.camera.position.set(P.pos.x+this.bobX*.5,P.feet+EYE+this.bobY,P.pos.z);
    this.camera.rotation.set(
      P.pitch+(shake?(Math.random()-.5)*shake*.8:0),
      P.yaw+(shake?(Math.random()-.5)*shake:0),
      this.bobX*.05+(shake?(Math.random()-.5)*shake*.5:0));
    if(shake)this.shakeT=Math.max(0,this.shakeT-dt*2.2);
  }
  tryMove(dx,dz){
    const P=this.player;
    if(dx)P.pos.x+=dx;
    if(dz)P.pos.z+=dz;
    for(let iter=0;iter<3;iter++){
      let moved=false;
      for(const c of this.colliders){
        if(c.solid===false)continue;
        if(c.y1<=P.feet+STEP||c.y0>=P.feet+EYE)continue;
        if(P.pos.x>c.minX-RAD&&P.pos.x<c.maxX+RAD&&P.pos.z>c.minZ-RAD&&P.pos.z<c.maxZ+RAD){
          const nx=THREE.MathUtils.clamp(P.pos.x,c.minX,c.maxX);
          const nz=THREE.MathUtils.clamp(P.pos.z,c.minZ,c.maxZ);
          const ddx=P.pos.x-nx,ddz=P.pos.z-nz,d2=ddx*ddx+ddz*ddz;
          if(d2>RAD*RAD)continue;
          if(d2>1e-8){
            const d=Math.sqrt(d2),push=RAD-d;
            P.pos.x+=ddx/d*push;P.pos.z+=ddz/d*push;
          }else{
            const toL=P.pos.x-c.minX,toR=c.maxX-P.pos.x,toB=P.pos.z-c.minZ,toF=c.maxZ-P.pos.z;
            const m=Math.min(toL,toR,toB,toF);
            if(m===toL)P.pos.x=c.minX-RAD;else if(m===toR)P.pos.x=c.maxX+RAD;
            else if(m===toB)P.pos.z=c.minZ-RAD;else P.pos.z=c.maxZ+RAD;
          }
          moved=true;
        }
      }
      if(!moved)break;
    }
  }
  supportAt(x,z){
    let s=0;const f=this.player.feet;
    for(const c of this.colliders){
      if(c.noSupport||c.solid===false)continue;
      if(x<c.minX||x>c.maxX||z<c.minZ||z>c.maxZ)continue;
      if(c.y1<=.002)continue;
      if(c.y1<=f+STEP+.002&&c.y1>s)s=c.y1;
    }
    return s;
  }
  floorMat(){
    const id=this.room().id;
    return {west:'earth',court:'stone',east:'wood',opera:'wood',shrine:'stone',hall:'stone'}[id]||'stone';
  }
  stepSound(mat,vol=1){
    if(this.player.hidden)mat='straw';
    this.audio.step(mat);
    if(this.npc)this.npc.onStep(this.noiseLevel*vol);
  }
  nearHide(){
    const p=this.player.pos;
    for(const h of this.hideSpots){
      if(!h.visible())continue;
      if(Math.hypot(p.x-h.x,p.z-h.z)<h.r)return true;
    }
    return false;
  }

  /* ---------------- 主循环 ---------------- */
  loop(){
    requestAnimationFrame(()=>this.loop());
    const dt=Math.min(.05,this.clock.getDelta());
    this.t+=dt;this.dt=dt;
    this.fps=this.fps*.93+(1/Math.max(dt,.0008))*.07;
    this.syncUi();

    if(!this.uiOpen)this.move(dt);
    if(!this.paused){
      this.parts.tick(this.t,dt);
      if(!this.uiOpen&&this.npc)this.npc.update(dt,this.t);
      updateInteract(this,dt);
      this.hud.tick(dt);
      this.hud.setFps(this.fps);
    }
    const S=this.state;
    this.postfx.dread=THREE.MathUtils.lerp(this.postfx.dread,
      Math.min(1,S.dreadN*.95+(this.npc?this.npc.closeProx*.35:0)),dt*1.6);
    this.postfx.cold=(this.safeUntil-this.t>0)?.55:0;
    this.audio.setDread(Math.min(1,S.dreadN*.85+(this.npc?this.npc.closeProx*.4:0)));

    if(this.torch&&this.torchOn)this.torch.intensity=6+Math.sin(this.t*13)*0.8+Math.random()*0.5;
    if(this.manor&&this.manor.anchors.ash){
      const a=this.manor.anchors.ash,sd=a.spd,p=a.pts.geometry.attributes.position;
      for(let i=0;i<sd.length;i++){
        let y=p.getY(i)-sd[i].vy*dt*3;
        if(y<0)y=7;
        p.setY(i,y);
        p.setX(i,p.getX(i)+Math.sin(this.t*.5+sd[i].ph)*dt*.12);
      }
      p.needsUpdate=true;
    }
    this.postfx.render(this.scene,this.camera,this.t);
  }
}

export const app=new App();
window.__app=app;

/* ---------------- 引导 UI ---------------- */
const $=s=>document.querySelector(s);
const on=(s,ev,fn)=>{const e=$(s);if(e)e.addEventListener(ev,fn);return e;};
const title=$('#title'),ends=$('#endscreen');
let diff='hard';
document.querySelectorAll('#diffPick .dbtn').forEach(b=>b.addEventListener('click',()=>{
  document.querySelectorAll('#diffPick .dbtn').forEach(x=>x.classList.remove('on'));
  b.classList.add('on');diff=b.dataset.diff;
}));
if(localStorage.getItem(SAVE_KEY))$('#btnContinue')?.classList.remove('hidden');

async function enter(load){
  await Promise.race([app.audio.init().catch(()=>{}),new Promise(r=>setTimeout(r,1500))]);
  if(app.audio.ready)app.audio.sting('dread');
  const ok=load?app.load():(()=>{app.boot(diff);return true;})();
  if(!ok){app.boot(diff);}
  title&&title.classList.add('hidden');
  $('#hud')?.classList.remove('hidden');
  const chip=$('#hintChip');
  if(chip){chip.classList.remove('hidden');setTimeout(()=>chip.classList.add('hidden'),11000);}
  app.input.requestLock();
  curtain(app,load?STORY.reenter:STORY.open);
}
app.enter=enter;
on('#btnStart','click',()=>enter(false));
on('#btnContinue','click',()=>enter(true));
on('#btnResumePlay','click',()=>app.togglePause(false));
on('#btnSave','click',()=>app.save());
on('#btnTitleBack','click',()=>location.reload());
on('#btnQuit','click',()=>location.reload());
on('#btnResume','click',()=>{
  app.dead=false;ends&&ends.classList.add('hidden');
  const hudEl=$('#hud');hudEl&&hudEl.classList.remove('hidden');
  const cp=app.state.checkpoint,p=app.player;
  p.pos.set(cp.pos[0],0,cp.pos[2]);p.feet=cp.pos[1]||0;p.vy=0;
  p.yaw=cp.yaw;p.pitch=-.02;p.vel.set(0,0,0);
  app.state.addDread(-42);
  app.npc&&app.npc.respawn();
  app.togglePause(false);app.input.requestLock();
  curtain(app,STORY.wakeup);
});
on('#jrClose','click',()=>app.hud&&app.hud.toggleJournal());
on('#panelRoot','click',e=>{if(e.target.id==='panelRoot')app.panels.close();});
const seenErr=new Set();
window.addEventListener('error',e=>{
  const f=(e.filename||'').split('/').pop();
  const mine=/^(main|hud|panels|story|interact|npc|state|manor|parts|textures|audio|postfx|input|util)\.js$/.test(f);
  if(!mine)return;                                  // 不劫持注入脚本的噪声
  const key=f+':'+e.message;
  if(seenErr.has(key))return;
  seenErr.add(key);
  console.error('[game]',f,e.message,e.lineno);
  if(window.__app&&window.__app.hud)window.__app.hud.toast('出错 '+f+':'+e.message,'bad');
});

/* =========================================================
   程序化音频：零素材。古筝( Karplus-Strong )、二胡、铜铃、
   唢呐、磬、更鼓、风、耳语、心跳、跳吓 —— 全部实时合成。
   ========================================================= */
const A4=440, NOTE={宫:261.63,商:293.66,角:329.63,徵:392.00,羽:440.00,
                    清角:349.23,变宫:493.88,少宫:523.25};

export class AudioEngine{
  constructor(){this.ctx=null;this.ready=false;this.muted=false;this._nodes=[];}

  async init(){
    if(this.ready)return;
    const C=window.AudioContext||window.webkitAudioContext;
    this.ctx=new C({latencyHint:'interactive'});
    const ctx=this.ctx;
    this.master=ctx.createGain(); this.master.gain.value=0.9;
    this.comp=ctx.createDynamicsCompressor();
    this.comp.threshold.value=-16; this.comp.ratio.value=5; this.comp.attack.value=.004; this.comp.release.value=.25;
    this.reverb=this._makeReverb(3.1,2.6);
    this.revSend=ctx.createGain(); this.revSend.gain.value=.32;
    this.revSend.connect(this.reverb).connect(this.comp);
    this.dry=ctx.createGain(); this.dry.gain.value=1;
    this.dry.connect(this.comp);
    this.comp.connect(this.master).connect(ctx.destination);
    this.noiseBuf=this._noise(3);
    this.ready=true;
    if(ctx.state==='suspended')await ctx.resume();
    this._startAmbience();
  }
  _now(){return this.ctx.currentTime;}
  _noise(sec){
    const ctx=this.ctx,len=Math.floor(ctx.sampleRate*sec),b=ctx.createBuffer(2,len,ctx.sampleRate);
    for(let c=0;c<2;c++){const d=b.getChannelData(c);let last=0;
      for(let i=0;i<len;i++){const w=Math.random()*2-1;last=(last+.02*w)/1.02;d[i]=last*3.2;} }
    return b;
  }
  _makeReverb(sec,decay){
    const ctx=this.ctx,len=Math.floor(ctx.sampleRate*sec),b=ctx.createBuffer(2,len,ctx.sampleRate);
    for(let c=0;c<2;c++){const d=b.getChannelData(c);
      for(let i=0;i<len;i++)d[i]=(Math.random()*2-1)*Math.pow(1-i/len,decay);}
    const cv=ctx.createConvolver();cv.buffer=b;
    const lp=ctx.createBiquadFilter();lp.type='lowpass';lp.frequency.value=3400;
    cv.connect(lp);lp.connect(this?this.comp||ctx.destination:ctx.destination);
    return cv;
  }
  _out(node,{rev=.35,pan=0,gain=1,attack=.01,hold=0,release=.2,peak=0}={}){
    const ctx=this.ctx,t=this._now();
    const g=ctx.createGain();
    g.gain.setValueAtTime(0,t);
    g.gain.linearRampToValueAtTime(gain,t+attack);
    if(hold)g.gain.setValueAtTime(gain,t+attack+hold);
    g.gain.exponentialRampToValueAtTime(.0001,t+attack+hold+release);
    let n=node;
    if(peak){const bp=ctx.createBiquadFilter();bp.type='peaking';bp.frequency.value=peak;bp.gain.value=9;node.connect(bp);n=bp;}
    const p=ctx.createStereoPanner();p.pan.value=pan;
    n.connect(g);g.connect(p);p.connect(this.dry);
    if(rev){const rs=ctx.createGain();rs.gain.value=rev;p.connect(rs);rs.connect(this.revSend);}
    return g;
  }

  /* ---------- 古筝：Karplus-Strong ---------- */
  guzheng(freq,{dur=1.6,pan=0,rev=.4,gain=.5,pluckPos=.12}={}){
    if(!this.ready)return;
    const ctx=this.ctx,S=ctx.sampleRate,N=Math.floor(S*dur);
    const buf=ctx.createBuffer(1,N,S),d=buf.getChannelData(0);
    const M=Math.max(2,Math.round(S/freq)),bp=Math.max(1,Math.round(M*pluckPos));
    const ring=new Float32Array(M);
    for(let i=0;i<M;i++)ring[i]=Math.random()*2-1;
    let idx=0,last=0;
    for(let i=0;i<N;i++){
      const cur=ring[idx];
      const nxt=ring[(idx+bp)%M];
      const v=(.5*(cur+nxt))*0.9955;          // 阻尼拨片
      ring[idx]=v;last=last*.6+v*.4;d[i]=last;
      idx=(idx+1)%M;
    }
    const src=ctx.createBufferSource();src.buffer=buf;
    const f=ctx.createBiquadFilter();f.type='bandpass';f.frequency.value=freq*2.1;f.Q.value=.8;
    src.connect(f);this._out(f,{pan,rev,gain,attack:.002,hold:0,release:dur*.2,peak:freq*3});
    src.start();
  }
  /* ---------- 五声音阶旋律 ---------- */
  melody(notes,{gap=.42,gain=.4,gliss=false}={}){
    notes.forEach((n,i)=>{
      const f=typeof n==='number'?n:(NOTE[n]||261.63);
      setTimeout(()=>this.guzheng(f,{gain,rev:.45}),i*gap*1000);
      if(gliss)setTimeout(()=>this.guzheng(f*1.006,{gain:gain*.6}),i*gap*1000+60);
    });
  }
  /* ---------- 二胡（长弓） ---------- */
  erhu(freq,{dur=2.4,pan=-.2,rev=.5,gain=.22,vib=6.5}={}){
    if(!this.ready)return;
    const ctx=this.ctx,t=this._now();
    const o=ctx.createOscillator();o.type='sawtooth';o.frequency.setValueAtTime(freq,t);
    const o2=ctx.createOscillator();o2.type='triangle';o2.frequency.setValueAtTime(freq*2.003,t);
    const lfo=ctx.createOscillator();lfo.frequency.value=vib;
    const lg=ctx.createGain();lg.gain.value=freq*.011;lfo.connect(lg);lg.connect(o.frequency);
    const f=ctx.createBiquadFilter();f.type='lowpass';f.frequency.value=1900;f.Q.value=3.5;
    const g2=ctx.createGain();g2.gain.value=.25;
    o.connect(f);o2.connect(g2);g2.connect(f);
    this._out(f,{pan,rev,gain,attack:.35,hold:dur*.45,release:dur*.35,peak:820});
    o.start();o2.start();lfo.start();o.stop(t+dur);o2.stop(t+dur);lfo.stop(t+dur);
  }
  /* ---------- 铜铃 / 磬 / 木鱼 ---------- */
  bell(freq=1568,{dur=2.2,gain=.18,pan=0}={}){
    if(!this.ready)return;
    const ctx=this.ctx,t=this._now();
    [1,2.41,3.83,5.12,6.9].forEach((m,i)=>{
      const o=ctx.createOscillator();o.type='sine';o.frequency.value=freq*m;
      const g=ctx.createGain();const a=g.gain;
      a.setValueAtTime(0,t);a.linearRampToValueAtTime(gain/(i+1.4),t+.004);
      a.exponentialRampToValueAtTime(.0001,t+dur/(1+i*.55));
      o.connect(g).connect(this.dry);
      const rs=ctx.createGain();rs.gain.value=.5;g.connect(rs);rs.connect(this.revSend);
      o.start(t);o.stop(t+dur);
    });
  }
  woodfish({gain=.3,pan=.1}={}){
    if(!this.ready)return;
    const ctx=this.ctx,t=this._now();
    const o=ctx.createOscillator();o.type='sine';
    o.frequency.setValueAtTime(430,t);o.frequency.exponentialRampToValueAtTime(180,t+.09);
    const f=ctx.createBiquadFilter();f.type='bandpass';f.frequency.value=900;f.Q.value=6;
    o.connect(f);this._out(f,{gain,pan,rev:.3,attack:.002,release:.16});
    o.start();o.stop(t+.3);
  }
  /* ---------- 更鼓 ---------- */
  drum({gain=.7,pan=0,dur=1.2}={}){
    if(!this.ready)return;
    const ctx=this.ctx,t=this._now();
    const o=ctx.createOscillator();o.type='sine';
    o.frequency.setValueAtTime(92,t);o.frequency.exponentialRampToValueAtTime(38,t+.28);
    const g=ctx.createGain();g.gain.setValueAtTime(gain,t);g.gain.exponentialRampToValueAtTime(.0001,t+dur);
    o.connect(g).connect(this.dry);
    const rs=ctx.createGain();rs.gain.value=.4;g.connect(rs);rs.connect(this.revSend);
    const n=ctx.createBufferSource();n.buffer=this.noiseBuf;
    const nf=ctx.createBiquadFilter();nf.type='highpass';nf.frequency.value=1400;
    const ng=ctx.createGain();ng.gain.setValueAtTime(gain*.25,t);ng.gain.exponentialRampToValueAtTime(.0001,t+.1);
    n.connect(nf).connect(ng).connect(this.dry);n.start();n.stop(t+.2);
    o.start();o.stop(t+dur);
  }
  /* ---------- 噪声类：风/脚步/开门/碎纸/火把 ---------- */
  noiseHit({dur=.22,freq=900,q=1,type='bandpass',gain=.2,pan=0,rev=.2,sweep=0}={}){
    if(!this.ready)return;
    const ctx=this.ctx,t=this._now();
    const n=ctx.createBufferSource();n.buffer=this.noiseBuf;n.loop=true;
    n.playbackRate.value=.8+Math.random()*.5;
    const f=ctx.createBiquadFilter();f.type=type;f.frequency.setValueAtTime(freq,t);f.Q.value=q;
    if(sweep)f.frequency.exponentialRampToValueAtTime(Math.max(60,freq*sweep),t+dur);
    n.connect(f);this._out(f,{gain,pan,rev,attack:Math.min(.02,dur*.2),release:dur,peak:freq*1.6});
    n.start();n.stop(t+dur+.05);
  }
  step(hard='wood'){
    const p={wood:{freq:520,gain:.12,dur:.13},stone:{freq:1150,gain:.16,dur:.15},
             earth:{freq:300,gain:.1,dur:.16},straw:{freq:2300,gain:.07,dur:.1}}[hard]||{freq:520,gain:.12,dur:.13};
    this.noiseHit({...p,q:1.2,pan:(Math.random()-.5)*.3});
  }
  creak(){
    if(!this.ready)return;
    const ctx=this.ctx,t=this._now();
    const o=ctx.createOscillator();o.type='sawtooth';
    o.frequency.setValueAtTime(120,t);
    o.frequency.linearRampToValueAtTime(210,t+.5);o.frequency.linearRampToValueAtTime(96,t+1.1);
    const f=ctx.createBiquadFilter();f.type='bandpass';f.frequency.value=680;f.Q.value=11;
    const g=ctx.createGain();g.gain.setValueAtTime(0,t);
    g.gain.linearRampToValueAtTime(.14,t+.1);g.gain.linearRampToValueAtTime(.0001,t+1.2);
    o.connect(f).connect(g);g.connect(this.dry);
    const rs=ctx.createGain();rs.gain.value=.4;g.connect(rs);rs.connect(this.revSend);
    o.start();o.stop(t+1.3);
  }
  /* ---------- 心跳 ---------- */
  setHeartRate(bpm){this._bpm=bpm||0;}
  _thump(){
    this.noiseHit({dur:.16,freq:58,q:.9,type:'lowpass',gain:.55,rev:.1});
    setTimeout(()=>this.noiseHit({dur:.13,freq:44,q:.9,type:'lowpass',gain:.34,rev:.1}),165);
  }
  /* ---------- 耳语（在"她"的位置） ---------- */
  whisper(pan=0,intensity=1){
    if(!this.ready)return;
    const ctx=this.ctx,t=this._now();
    const n=ctx.createBufferSource();n.buffer=this.noiseBuf;n.loop=true;
    const f1=ctx.createBiquadFilter();f1.type='bandpass';f1.frequency.value=1700+Math.random()*900;f1.Q.value=5;
    const f2=ctx.createBiquadFilter();f2.type='bandpass';f2.frequency.value=3100;f2.Q.value=7;
    const am=ctx.createOscillator();am.frequency.value=5+Math.random()*7;
    const amg=ctx.createGain();amg.gain.value=.45;am.connect(amg);
    const g=ctx.createGain();g.gain.value=.001;
    amg.connect(g.gain);
    n.connect(f1).connect(f2).connect(g);
    const p=ctx.createStereoPanner();p.pan.value=pan;g.connect(p);
    p.connect(this.dry);
    const rs=ctx.createGain();rs.gain.value=.6;g.connect(rs);rs.connect(this.revSend);
    const dur=1.1+Math.random()*1.4;
    g.gain.setValueAtTime(.0001,t);g.gain.linearRampToValueAtTime(.16*intensity,t+.25);
    g.gain.linearRampToValueAtTime(.0001,t+dur);
    n.start();am.start();n.stop(t+dur);am.stop(t+dur);
  }
  /* ---------- 跳吓 ---------- */
  jump(){
    if(!this.ready)return;
    const ctx=this.ctx,t=this._now();
    this.noiseHit({dur:.9,freq:2600,q:.4,type:'highpass',gain:.75,rev:.7,sweep:.12});
    [98,104,147,233].forEach(f=>{
      const o=ctx.createOscillator();o.type='square';o.frequency.setValueAtTime(f*3,t);
      o.frequency.exponentialRampToValueAtTime(f*.6,t+.75);
      const g=ctx.createGain();g.gain.setValueAtTime(.16,t);g.gain.exponentialRampToValueAtTime(.0001,t+.9);
      const lp=ctx.createBiquadFilter();lp.type='lowpass';lp.frequency.value=2200;
      o.connect(lp).connect(g).connect(this.dry);o.start();o.stop(t+1);
    });
    this.bell(2093,{dur:3.4,gain:.3});
  }
  sting(kind='dread'){
    if(kind==='dread'){[55,58.3,82.4].forEach(f=>this.erhu(f,{dur:3.4,gain:.1,vib:1.2,pan:Math.random()-.5}));}
    else if(kind==='reveal'){this.bell(1046,{dur:3,gain:.24});this.erhu(392,{dur:2.6,gain:.15,vib:4});}
    else if(kind==='success'){this.melody(['宫','角','徵','少宫'],{gap:.16,gain:.34});}
    else if(kind==='fail'){this.guzheng(110,{dur:1.4,gain:.5});this.noiseHit({dur:.5,freq:220,type:'lowpass',gain:.3});}
  }
  /* ---------- 环境底 ---------- */
  _startAmbience(){
    const ctx=this.ctx;
    // 风
    const n=ctx.createBufferSource();n.buffer=this.noiseBuf;n.loop=true;
    const lp=ctx.createBiquadFilter();lp.type='lowpass';lp.frequency.value=420;
    const bp=ctx.createBiquadFilter();bp.type='bandpass';bp.frequency.value=260;bp.Q.value=.7;
    const g=ctx.createGain();g.gain.value=.05;
    const lfo=ctx.createOscillator();lfo.frequency.value=.07;
    const lg=ctx.createGain();lg.gain.value=.035;lfo.connect(lg).connect(g.gain);
    n.connect(lp).connect(bp).connect(g);
    g.connect(this.dry);const rs=ctx.createGain();rs.gain.value=.5;g.connect(rs);rs.connect(this.revSend);
    n.start();lfo.start();this.windGain=g;
    // 低频阴鸣
    const d1=ctx.createOscillator();d1.type='sine';d1.frequency.value=41.2;
    const d2=ctx.createOscillator();d2.type='sine';d2.frequency.value=41.2*1.007;
    const d3=ctx.createOscillator();d3.type='sawtooth';d3.frequency.value=20.6;
    const dlp=ctx.createBiquadFilter();dlp.type='lowpass';dlp.frequency.value=140;
    const dg=ctx.createGain();dg.gain.value=.05;
    d1.connect(dlp);d2.connect(dlp);d3.connect(dlp);dlp.connect(dg).connect(this.dry);
    d1.start();d2.start();d3.start();this.droneGain=dg;
    this._bpm=0;
    this._hb=null;this._scheduleHeart();
    this._scheduleRandom();
  }
  _scheduleHeart(){
    clearTimeout(this._hb);
    const go=()=>{ if(this._bpm>0)this._thump();
      this._hb=setTimeout(go,Math.max(280,60000/this._bpm||0)); };
    this._hb=setTimeout(go,400);
  }
  _scheduleRandom(){
    const loop=()=>{
      if(this.ready&&!this.muted){
        const r=Math.random();
        if(r<.22)this.creak();
        else if(r<.4)this.noiseHit({dur:.9,freq:1800,q:2,gain:.05,pan:Math.random()*1.6-.8,rev:.8}); // 纸响
        else if(r<.55)this.bell(1318+Math.random()*400,{dur:3,gain:.06,pan:Math.random()*1.4-.7});
        else if(r<.68)this.whisper(Math.random()*1.6-.8,.5);
        else if(r<.78)this.drum({gain:.2});
        else if(r<.86)this.guzheng(196+Math.random()*120,{dur:2.4,gain:.1,pan:Math.random()-.5});
      }
      setTimeout(loop,5200+Math.random()*11000);
    };
    setTimeout(loop,7000);
  }
  /** 恐惧强度 0~1：压低风声、抬升阴鸣、加速心跳 */
  setDread(v){
    if(!this.ready)return;
    const t=this._now();
    this.droneGain.gain.linearRampToValueAtTime(.04+v*.16,t+.6);
    this.windGain.gain.linearRampToValueAtTime(.05-v*.035,t+.6);
    this.setHeartRate(v<.15?0:48+v*68);
  }
  playNote(nameOrFreq,opt){this.guzheng(typeof nameOrFreq==='number'?nameOrFreq:(NOTE[nameOrFreq]||262),opt);}
  noteFreq(n){return NOTE[n]||261.63;}
  setMuted(m){this.muted=m;if(this.master)this.master.gain.value=m?0:.9;}
}
