/* 工尺谱 */
.notes{display:flex;gap:10px;justify-content:center;margin:10px 0}
.note{width:64px;height:80px;background:#f6ecd2;border:1px solid #8a6a3c;cursor:pointer;display:grid;place-items:center;
  font-size:26px;color:#2b1d10;position:relative;transition:.14s}
.note:hover{background:#fff6dd;transform:translateY(-3px)}
.note.on{background:var(--blood);color:#ffe9c9;border-color:var(--blood-bright)}
.track{display:flex;gap:6px;justify-content:center;margin-top:14px}
.pip{width:38px;height:52px;border:1px solid #8a6a3c;background:rgba(255,255,255,.3);display:grid;place-items:center;font-size:20px}

/* 符咒 */
#talCanvas{display:block;background:#f7edd4;border:1px solid #8a6a3c;cursor:crosshair;touch-action:none}
.ghost-stroke{position:absolute;inset:0;pointer-events:none;opacity:0;transition:opacity .3s}

/* 纸人 */
.pdolls{display:flex;gap:14px;justify-content:center}
.pdoll{width:96px;padding:8px;border:1px solid #8a6a3c;background:rgba(255,246,220,.5);cursor:pointer;text-align:center;transition:.16s}
.pdoll:hover{transform:translateY(-4px);box-shadow:0 8px 18px rgba(0,0,0,.28)}
.pdoll .body{height:104px;margin:0 auto 6px;width:64px;background:var(--c,#9a8a6a);
  clip-path:polygon(30% 0,70% 0,86% 22%,78% 100%,22% 100%,14% 22%);border:1px solid rgba(0,0,0,.3);position:relative}
.pdoll .body::before{content:"";position:absolute;left:50%;top:-2px;width:34px;height:34px;border-radius:50%;
  transform:translateX(-50%);background:#f2e3c4;border:1px solid rgba(0,0,0,.25)}
.pdoll .lbl{font-size:12px;letter-spacing:.2em}
.chips{display:flex;gap:8px;justify-content:center;margin-top:12px;flex-wrap:wrap}
.chip{padding:5px 14px;border:1px solid #8a6a3c;font-size:14px;cursor:pointer;background:rgba(255,255,255,.25)}
.chip.on{background:var(--blood);color:#fff}

/* 杆秤 */
.scale-wrap{width:620px;height:190px;position:relative;background:rgba(255,246,220,.3);border:1px solid #8a6a3c}
#scaleBeam{position:absolute;left:20px;right:20px;top:78px;height:8px;background:linear-gradient(90deg,#7a5a2c,#a9853f);
  transform-origin:50% 50%;transition:transform .6s cubic-bezier(.3,1.4,.4,1)}
.pivot{position:absolute;left:50%;top:86px;width:0;height:0;border-left:14px solid transparent;
  border-right:14px solid transparent;border-top:34px solid #4a3a2a;transform:translateX(-50%)}
.hanger{position:absolute;top:34px;width:52px;text-align:center;cursor:pointer;font-size:12px;color:#2b1d10}
.hanger .box{width:44px;height:38px;margin:0 auto;background:#c8b184;border:1px solid #6a4a24;display:grid;place-items:center}
.hanger.on .box{background:var(--blood);color:#fff}

/* 六礼 */
.bowls{display:grid;grid-template-columns:repeat(6,96px);gap:8px;justify-content:center}
.bowl{height:104px;border:1px solid #8a6a3c;background:rgba(255,246,220,.4);display:grid;place-items:center;
  font-size:13px;line-height:1.5;text-align:center;cursor:pointer;position:relative;transition:.16s}
.bowl:hover{background:rgba(255,250,232,.7)}
.bowl .idx{position:absolute;top:2px;left:4px;font-size:11px;color:#8c1611;letter-spacing:.1em}
.bag{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-top:14px;max-width:640px}
.bag .b{padding:7px 13px;border:1px solid #6a4a24;background:#e8dab8;cursor:pointer;font-size:14px}
.bag .b:hover{background:#fff2d4}
.bag .b.used{opacity:.3;cursor:default}

/* 灯谜 */
.riddle-q{font-size:19px;line-height:2.1;text-align:center;color:#5a1310;margin:6px 0 16px;letter-spacing:.1em}
.opts{display:grid;grid-template-columns:repeat(4,110px);gap:10px;justify-content:center}
.opt{height:64px;display:grid;place-items:center;border:1px solid #8a6a3c;font-size:20px;cursor:pointer;background:rgba(255,246,220,.5)}
.opt:hover{background:#fff4d8;transform:translateY(-2px)}

/* ============ 引魂簿 ============ */
#journal{position:fixed;inset:0;z-index:34;display:grid;place-items:center;background:rgba(2,2,2,.88);cursor:default}
.jr-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}
.jr-head h2{font-size:26px;letter-spacing:.5em;color:var(--blood-bright)}
#jrClose{font-family:var(--serif);background:none;border:1px solid #8a6a3c;color:#bfae8c;padding:5px 14px;cursor:pointer}
#journal{padding:0}
#journal>div{background:linear-gradient(150deg,#e9dcba,#cdb98e);color:#241a0e;
  width:min(1000px,92vw);max-height:82vh;overflow:auto;padding:24px 30px;border:2px solid #6a4a24}
.jr-cols{display:grid;grid-template-columns:1fr 1.6fr 1fr;gap:26px}
.jr-cols h3{font-size:14px;letter-spacing:.3em;color:#7d1108;border-bottom:1px solid rgba(125,17,8,.3);padding-bottom:5px;margin-bottom:10px}
.jr-cols ul{list-style:none;display:flex;flex-direction:column;gap:9px}
.jr-cols li{font-size:15px;line-height:1.75;padding-left:12px;border-left:2px solid rgba(125,17,8,.28)}
.jr-cols li::marker{content:""}

/* ============ 标题 ============ */
#title{position:fixed;inset:0;z-index:40;display:grid;place-items:center;cursor:default;
  background:radial-gradient(ellipse at 50% 120%,#2a0908 0%,#0a0605 45%,#000 100%)}
.t-fog{position:absolute;inset:0;opacity:.5;
  background:radial-gradient(circle at 20% 70%,rgba(140,22,17,.22),transparent 45%),
             radial-gradient(circle at 82% 25%,rgba(120,90,40,.16),transparent 42%);
  animation:fogdrift 24s ease-in-out infinite alternate}
@keyframes fogdrift{to{transform:translate3d(-4%,2%,0) scale(1.12)}}
.t-lantern{position:absolute;width:56px;height:74px;border-radius:50%/38%;
  background:radial-gradient(circle at 50% 40%,#e8452f,#6c100a);
  box-shadow:0 0 60px 16px rgba(220,60,30,.4);animation:sway 5.5s ease-in-out infinite alternate}
.t-lantern::after{content:"";position:absolute;left:50%;bottom:-26px;width:2px;height:26px;background:#5a3a1c;transform:translateX(-50%)}
.l1{left:11%;top:16%}.l2{right:13%;top:24%;animation-delay:-2s;transform:scale(.8)}
@keyframes sway{from{transform:rotate(-5deg)}to{transform:rotate(5deg) translateY(-8px)}}
.t-frame{position:relative;text-align:center;padding:40px 60px;max-width:760px;
  border-top:1px solid rgba(201,162,74,.4);border-bottom:1px solid rgba(201,162,74,.4)}
.t-seal{position:absolute;right:-8px;top:-14px;width:44px;height:44px;display:grid;place-items:center;
  color:#f0d7a8;background:#8c1611;font-size:20px;transform:rotate(8deg);box-shadow:0 0 18px rgba(140,22,17,.6)}
.t-main{font-size:88px;letter-spacing:.22em;color:#e7d3a6;line-height:1;
  text-shadow:0 0 40px rgba(200,32,26,.55),0 6px 0 #2a0d0a;animation:flick 6s infinite}
@keyframes flick{0%,92%,100%{opacity:1}94%{opacity:.55}96%{opacity:.9}98%{opacity:.4}}
.t-sub{font-size:24px;letter-spacing:1.1em;color:var(--blood-bright);margin:14px 0 22px;text-indent:1.1em}
.t-blurb{font-size:16px;line-height:2.1;color:#a8977a;margin-bottom:26px}
.t-blurb b{color:var(--blood-bright)}
.t-diff{display:flex;gap:10px;justify-content:center;margin-bottom:26px}
.dbtn{font-family:var(--serif);background:rgba(20,12,10,.7);border:1px solid rgba(201,162,74,.3);
  color:#9c8c6c;padding:9px 18px;cursor:pointer;display:flex;flex-direction:column;gap:2px;transition:.2s}
.dbtn b{font-size:17px;letter-spacing:.3em}
.dbtn i{font-size:11px;font-style:normal;letter-spacing:.1em;opacity:.75}
.dbtn:hover{color:#d9c8a0;border-color:var(--gold)}
.dbtn.on{color:#fff;border-color:var(--blood-bright);background:rgba(140,22,17,.32);box-shadow:0 0 20px rgba(140,22,17,.4)}
.t-acts{display:flex;gap:14px;justify-content:center}
.tbtn{font-family:var(--serif);font-size:20px;letter-spacing:.4em;padding:13px 42px;cursor:pointer;
  border:1px solid var(--gold);background:transparent;color:var(--paper);transition:.22s}
.tbtn:hover{background:var(--blood);border-color:var(--blood-bright);color:#fff;letter-spacing:.5em;box-shadow:0 0 30px rgba(140,22,17,.5)}
.tbtn.main{border-color:var(--blood-bright);color:#f0d7a8}
.tbtn.ghost{font-size:16px;padding:11px 26px;border-color:rgba(201,162,74,.35);color:#9c8c6c}
.t-notice{margin-top:30px;font-size:12px;line-height:2;color:#6b5d47;letter-spacing:.08em}
.t-notice b{color:#a8977a}
.kbd{display:inline-block;border:1px solid rgba(201,162,74,.35);padding:0 6px;margin:0 2px;color:#a8977a;font-family:system-ui}

/* ============ 幕间 ============ */
#curtain{position:fixed;inset:0;z-index:44;display:grid;place-items:center;background:#000;cursor:default}
.cu-text{font-size:30px;line-height:2.4;letter-spacing:.3em;color:#cbbb92;text-align:center;max-width:800px;
  padding:0 30px;text-shadow:0 0 30px rgba(140,22,17,.4);opacity:0;animation:cuIn 1.4s forwards}
.cu-text em{color:var(--blood-bright);font-style:normal}
@keyframes cuIn{from{opacity:0;transform:translateY(18px);filter:blur(6px)}to{opacity:1;transform:none;filter:none}}

/* ============ 结局 ============ */
#endscreen{position:fixed;inset:0;z-index:46;display:grid;place-items:center;text-align:center;cursor:default;
  background:radial-gradient(ellipse at 50% 40%,#380705,#080202 70%)}
.en-kicker{font-size:13px;letter-spacing:.8em;color:var(--gold);opacity:.7;margin-bottom:16px}
.en-title{font-size:64px;letter-spacing:.3em;color:#e7d3a6;margin-bottom:24px;text-shadow:0 0 40px rgba(200,32,26,.55)}
.en-body{font-size:18px;line-height:2.3;color:#a8977a;max-width:640px;margin-bottom:34px}
.en-acts{display:flex;gap:14px;justify-content:center}

/* ============ 暂停 ============ */
#pause{position:fixed;inset:0;z-index:38;display:grid;place-items:center;background:rgba(0,0,0,.86);cursor:default}
.pa-box{background:linear-gradient(160deg,#e8dbb9,#c9b58c);color:#241a0e;padding:28px 34px;width:min(620px,90vw);border:2px solid #6a4a24}
.pa-box h3{font-size:22px;letter-spacing:.4em;color:#7d1108;margin-bottom:16px;text-align:center}
.pa-list{list-style:none;display:flex;flex-direction:column;gap:8px;font-size:15px;line-height:1.7}
.pa-list li{padding-left:12px;border-left:2px solid rgba(125,17,8,.3)}
.pa-list b{color:#7d1108;font-family:system-ui}
.pa-acts{display:flex;gap:10px;justify-content:center;margin-top:22px;flex-wrap:wrap}
.pa-acts .tbtn{font-size:15px;padding:9px 22px;border-color:#6a4a24;color:#3a2a16}
.pa-acts .tbtn:hover{background:#7d1108;color:#f0e3c6;border-color:#7d1108}

@media (max-width:820px){
  .t-main{font-size:52px}.jr-cols{grid-template-columns:1fr}
  #objective{display:none}.wuxing{grid-template-columns:repeat(3,84px);grid-template-rows:repeat(3,84px)}
  .scale-wrap{width:340px}.bowls{grid-template-columns:repeat(3,92px)}
}

</style>
</head>
<body>

<canvas id="scene"></canvas>
<div id="grain" aria-hidden="true"></div>
<div id="bloodVig" aria-hidden="true"></div>

<!-- ============ HUD ============ -->
<div id="hud" class="hidden">
  <div id="crosshair"></div>
  <div id="prompt"><span id="promptKey">E</span><span id="promptText"></span></div>

  <div id="soulLamp">
    <div class="lamp-label">魂灯</div>
    <div class="lamp-bar"><i id="lampFill"></i></div>
    <div class="lamp-num" id="lampNum">0</div>
  </div>

  <div id="breathWrap" class="hidden">
    <div class="breath-label">屏息</div>
    <div class="breath-bar"><i id="breathFill"></i></div>
  </div>

  <div id="objective">
    <div class="obj-title" id="objTitle">第一章</div>
    <div class="obj-text" id="objText"></div>
  </div>

  <div id="invBar"></div>
  <div id="toastStack"></div>
  <div id="whisper"></div>

  <div id="hintChip" class="hidden">按 <b>H</b> 燃香平心 · <b>J</b> 翻簿 · <b>TAB</b> 囊中物</div>
</div>

<!-- ============ 对话 ============ -->
<div id="dialog" class="hidden">
  <div class="dlg-portrait" id="dlgPortrait"><span id="dlgPortraitGlyph">嬿</span></div>
  <div class="dlg-body">
    <div class="dlg-name" id="dlgName"></div>
    <div class="dlg-text" id="dlgText"></div>
    <div class="dlg-choices" id="dlgChoices"></div>
  </div>
</div>

<!-- ============ 谜题面板容器 ============ -->
<div id="panelRoot" class="hidden"><div id="panelInner"></div></div>

<!-- ============ 日志/簿 ============ -->
<div id="journal" class="hidden">
  <div class="jr-head">
    <h2>引魂簿</h2>
    <button id="jrClose">合上 [J]</button>
  </div>
  <div class="jr-cols">
    <div><h3>所求</h3><ul id="jrGoals"></ul></div>
    <div><h3>所见所闻</h3><ul id="jrNotes"></ul></div>
    <div><h3>囊中物</h3><ul id="jrItems"></ul></div>
  </div>
</div>

<!-- ============ 标题 ============ -->
<div id="title">
  <div class="t-fog"></div>
  <div class="t-lantern l1"></div>
  <div class="t-lantern l2"></div>
  <div class="t-frame">
    <div class="t-seal">壹</div>
    <h1 class="t-main">引魂宅</h1>
    <div class="t-sub">红 妆 劫</div>
    <p class="t-blurb">
      民国十七年秋，你在槐宅门外醒来。<br>
      宅中今夜要办一桩冥婚，聘的是一位<b>从未谋面的活人</b>——你。<br>
      十道机关，六礼已成其五。天一亮，盖头就要落到你头上。
    </p>
    <div class="t-diff" id="diffPick">
      <button class="dbtn" data-diff="normal"><b>夜探</b><i>可循迹而行</i></button>
      <button class="dbtn on" data-diff="hard"><b>凶宅</b><i>阴气侵蚀 · 无指引</i></button>
      <button class="dbtn" data-diff="nightmare"><b>夺舍</b><i>她一直在看着你</i></button>
    </div>
    <div class="t-acts">
      <button id="btnStart" class="tbtn main">推 门 而 入</button>
      <button id="btnContinue" class="tbtn ghost hidden">续 前 缘</button>
    </div>
    <div class="t-notice">
      本作含惊吓、幽闭与民俗恐怖元素，请酌情游玩。<br>
      建议戴耳机、关灯。所有女性角色均为成年人设，魅惑止于氛围与暗示，不含露骨内容。<br>
      <span class="kbd">WASD</span> 行走 · <span class="kbd">Shift</span> 疾走 · <span class="kbd">Ctrl</span> 屏息 · <span class="kbd">E</span> 交互 · <span class="kbd">Tab</span> 囊中物 · <span class="kbd">J</span> 簿 · <span class="kbd">Esc</span> 释义
    </div>
  </div>
</div>

<!-- ============ 幕间 ============ -->
<div id="curtain" class="hidden">
  <div class="cu-text" id="curtainText"></div>
</div>

<!-- ============ 死亡/结局 ============ -->
<div id="endscreen" class="hidden">
  <div class="en-kicker" id="enKicker"></div>
  <h2 class="en-title" id="enTitle"></h2>
  <p class="en-body" id="enBody"></p>
  <div class="en-acts">
    <button id="btnResume" class="tbtn main">自 香炉前 醒来</button>
    <button id="btnQuit" class="tbtn ghost">回到门外</button>
  </div>
</div>

<!-- ============ 暂停释义 ============ -->
<div id="pause" class="hidden">
  <div class="pa-box">
    <h3>引魂宅 · 释义</h3>
    <ul class="pa-list">
      <li><b>WASD</b> 行走 · <b>Shift</b> 疾走（脚步响亮，她会听见）</li>
      <li><b>E</b> 查看 / 拾取 / 使用 · 手持物时对目标使用</li>
      <li><b>Ctrl</b> 屏息 —— 藏身时她走近，屏息可躲过</li>
      <li><b>H</b> 于香炉前燃香，平定阴气，方圆之内她不敢入</li>
      <li><b>Tab</b> 囊中物 · <b>J</b> 引魂簿（线索与所求）</li>
      <li><b>魂灯</b> 即你的心智。灯灭，你便不再是自己</li>
    </ul>
    <div class="pa-acts">
      <button id="btnResumePlay" class="tbtn main">继 续</button>
      <button id="btnSave" class="tbtn ghost">刻 印（存档）</button>
      <button id="btnTitleBack" class="tbtn ghost">回 门 外</button>
    </div>
  </div>
</div>




