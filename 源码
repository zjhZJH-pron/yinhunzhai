#!/usr/bin/env node
/* =============================================================
 * fix-zip-separators.js
 *
 * .NET Framework 的 ZipFile / PowerShell 的 Compress-Archive 在
 * Windows 上会把路径分隔符写成 '\' —— 而 ZIP 规范（APPNOTE 4.4.17）
 * 规定目录分隔符必须是 '/'。Windows 资源管理器容忍反斜杠，
 * 但 7-Zip / unzip / macOS 归档工具会把它当成文件名的一部分，
 * 于是解出来是一堆形如 "resources\app\game.html" 的单层文件。
 *
 * 本工具只改「名字段」里的字节，不碰任何文件数据，因此安全。
 * 用法： node desktop/fix-zip-separators.js <a.zip>
 * ============================================================= */
const fs = require('fs');
const path = require('path');

function fix(file) {
  const buf = fs.readFileSync(file);

  // 定位 EOCD
  let eocd = -1;
  for (let i = buf.length - 22; i > Math.max(0, buf.length - 66000); i--) {
    if (buf.readUInt32LE(i) === 0x06054b50) { eocd = i; break; }
  }
  if (eocd < 0) throw new Error('找不到 EOCD：' + file);

  const total = buf.readUInt16LE(eocd + 10);
  let p = buf.readUInt32LE(eocd + 16);
  let patched = 0, localSeen = new Set();

  const slashName = (base, nameLen) => {
    for (let k = 0; k < nameLen; k++) {
      if (buf[base + k] === 0x5c) { buf[base + k] = 0x2f; patched++; }
    }
  };

  for (let i = 0; i < total; i++) {
    if (buf.readUInt32LE(p) !== 0x02014b50) throw new Error('中央目录项签名异常 @' + p);
    const nameLen = buf.readUInt16LE(p + 28);
    const extraLen = buf.readUInt16LE(p + 30);
    const cmtLen = buf.readUInt16LE(p + 32);
    const lhOff = buf.readUInt32LE(p + 42);

    // 中央目录里的名字
    slashName(p + 46, nameLen);

    // 对应本地头的名字（同一本地头可能被引用多次，去重）
    if (!localSeen.has(lhOff)) {
      localSeen.add(lhOff);
      if (buf.readUInt32LE(lhOff) === 0x04034b50) {
        slashName(lhOff + 30, buf.readUInt16LE(lhOff + 26));
      }
    }
    p += 46 + nameLen + extraLen + cmtLen;
  }

  fs.writeFileSync(file, buf);
  return { total, patched };
}

const target = process.argv[2];
if (!target) { console.error('用法: node fix-zip-separators.js <a.zip>'); process.exit(1); }
const r = fix(target);
console.log(`✓ ${path.basename(target)}  条目 ${r.total} · 修正分隔符 ${r.patched} 处`);

/* 引魂宅 · 红妆劫 — Electron 主进程
 * 跨平台外壳：Windows / macOS / Linux 共用
 */
const { app, BrowserWindow, Menu, shell, dialog, ipcMain } = require('electron');
const path = require('path');
const fs = require('fs');

const APP_TITLE = '引魂宅 · 红妆劫';
const isMac = process.platform === 'darwin';
// 自检模式：真正加载一次游戏并把结果写盘，用于验证打包产物（不是验证源码）
//   YinHunZhai.exe --smoke-test
const SMOKE = process.argv.includes('--smoke-test');

// 单实例：第二次启动时聚焦已有窗口
if (!app.requestSingleInstanceLock()) {
  app.quit();
}

let win = null;

function createWindow() {
  win = new BrowserWindow({
    width: 1360,
    height: 860,
    minWidth: 900,
    minHeight: 620,
    title: APP_TITLE,
    backgroundColor: '#000000',
    show: false,
    autoHideMenuBar: true,          // 恐怖氛围：默认不显示菜单栏，按 Alt 唤出
    icon: path.join(__dirname, 'icon.png'),
    webPreferences: {
      preload: path.join(__dirname, 'preload.js'),
      contextIsolation: true,
      nodeIntegration: false,
      sandbox: true,
      spellcheck: false,
      // 游戏需要指针锁定与 WebGL
      experimentalFeatures: false,
    },
  });

  win.loadFile(path.join(__dirname, 'game.html'));
  win.once('ready-to-show', () => { if (!SMOKE) win.show(); });

  if (SMOKE) {
    win.webContents.once('did-finish-load', async () => {
      const outFile = path.join(app.getPath('temp'), 'yinhunzhai-smoke.json');
      let result;
      try {
        result = await win.webContents.executeJavaScript(`(function(){
          return new Promise(function(res){
            var btn = document.getElementById('btnStart');
            if (btn) btn.click();                       // 真的推门而入，走完整启动路径
            var t = setInterval(function(){
              var a = window.__app;
              if (a && a.running && a.interactives && a.interactives.length) {
                clearInterval(t);
                a.player.pos.set(0, 0, 13.2);           // 挪进喜堂中央，确认可移动
                res({ ok: true, three: window.THREE.REVISION,
                      interactables: a.interactives.length,
                      colliders: a.colliders.length,
                      room: a.room().name,
                      chapter: a.state.chapter });
              }
            }, 150);
            setTimeout(function(){
              clearInterval(t);
              var a = window.__app;
              res({ ok: false, hasApp: !!a, running: !!(a && a.running),
                    three: window.THREE ? window.THREE.REVISION : null,
                    err: (window.__bootErr || null) });
            }, 25000);
          });
        })()`);
      } catch (e) {
        result = { ok: false, error: String(e && e.message || e) };
      }
      try { fs.writeFileSync(outFile, JSON.stringify(result, null, 2)); } catch (e) { /* ignore */ }
      app.exit(result.ok ? 0 : 1);
    });
  }

  // 拦截外链：游戏内不应跳转浏览器
  win.webContents.setWindowOpenHandler(({ url }) => {
    if (/^https?:/i.test(url)) shell.openExternal(url);
    return { action: 'deny' };
  });

  win.on('closed', () => { win = null; });

  // F11 / Alt+Enter 切全屏
  win.webContents.on('before-input-event', (e, input) => {
    if (input.type !== 'keyDown') return;
    if (input.key === 'F11' || (input.alt && input.key === 'Enter')) {
      win.setFullScreen(!win.isFullScreen());
      e.preventDefault();
    }
  });

  win.setTitle(APP_TITLE);
  buildMenu();
}

function buildMenu() {
  const template = [
    {
      label: '游戏',
      submenu: [
        {
          label: '重新开始（清除存档）',
          click: async () => {
            const r = await dialog.showMessageBox(win, {
              type: 'warning',
              buttons: ['清除', '取消'],
              defaultId: 1,
              cancelId: 1,
              title: '清除存档',
              message: '确定要烧掉引魂簿？',
              detail: '存档会回到「门外」，已解开的机关与线索一并抹去。此操作不可撤销。',
            });
            if (r.response === 0) {
              await win.webContents.executeJavaScript('try{localStorage.clear()}catch(e){}');
              win.reload();
            }
          },
        },
        { label: '打开存档所在文件夹', click: () => shell.openPath(app.getPath('userData')) },
        { type: 'separator' },
        { role: 'quit', label: '退出' },
      ],
    },
    {
      label: '视图',
      submenu: [
        { label: '全屏 / 窗口', accelerator: 'F11', click: () => win && win.setFullScreen(!win.isFullScreen()) },
        { role: 'togglefullscreen', label: '切换全屏' },
        { type: 'separator' },
        { role: 'resetZoom', label: '实际大小' },
        { role: 'zoomIn', label: '放大' },
        { role: 'zoomOut', label: '缩小' },
        { type: 'separator' },
        { role: 'reload', label: '重进本宅' },
      ],
    },
    {
      label: '帮助',
      submenu: [
        {
          label: '操作释义',
          click: () => dialog.showMessageBox(win, {
            title: '操作释义',
            message: APP_TITLE,
            detail: [
              'WASD 行走 · Shift 疾走（脚步响亮，她听得见）',
              '鼠标 视角 · E 查看 / 拾取 / 动手',
              'Ctrl 屏息 —— 藏身时她走近，屏息可躲过',
              'H 于香炉前燃香，平定阴气，方圆之内她不敢入',
              'F 火折子（照亮，也照得见她）',
              'Tab / J 囊中物与引魂簿 · G 问柳三娘卖关子',
              'F11 全屏 · Alt 唤出菜单栏',
              '',
              '魂灯即你的心智。灯灭，你便不再是自己。',
              '每破一道机关，宅门松一道闩；九闩尽落，以九宫算开最后一道。',
            ].join('\n'),
            buttons: ['知道了'],
          }),
        },
        {
          label: '关于',
          click: () => dialog.showMessageBox(win, {
            title: '关于',
            message: APP_TITLE,
            detail: '中式恐怖 3D 密室逃脱\n\n全程序化生成：建模、贴图、音乐、音效无一使用外部素材。\n以民国冥婚民俗为题，谜题根植于五行方色、生数、昭穆、六礼、洛书九宫。\n\n分级提示：含惊吓、幽闭与民俗恐怖元素。所有女性角色均为成年人设，魅惑止于氛围与暗示，不含露骨内容。',
            buttons: ['好'],
          }),
        },
      ],
    },
  ];

  if (isMac) {
    template.unshift({
      label: APP_TITLE,
      submenu: [
        { role: 'about', label: '关于' },
        { type: 'separator' },
        { role: 'hide', label: '隐藏' },
        { role: 'hideOthers', label: '隐藏其它' },
        { role: 'unhide', label: '全部显示' },
        { type: 'separator' },
        { role: 'quit', label: '退出' },
      ],
    });
  }

  Menu.setApplicationMenu(Menu.buildFromTemplate(template));
}

app.whenReady().then(() => {
  createWindow();
  app.on('activate', () => { if (BrowserWindow.getAllWindows().length === 0) createWindow(); });
});

app.on('second-instance', () => {
  if (win) { if (win.isMinimized()) win.restore(); win.focus(); }
});

app.on('window-all-closed', () => { if (!isMac) app.quit(); });

// 关掉无关的 GPU 警告噪声
app.on('child-process-gone', () => {});

#!/usr/bin/env node
/* 生成 icon.png（256×256 红灯笼）——只用 Node 内置 zlib，无图像库依赖。
 * 用法： node desktop/make-icon.js
 */
const fs = require('fs');
const path = require('path');
const zlib = require('zlib');

const W = 256, H = 256;
const px = Buffer.alloc(W * H * 4);

const clamp = (v, a, b) => v < a ? a : v > b ? b : v;
const set = (x, y, r, g, b, a = 255) => {
  if (x < 0 || y < 0 || x >= W || y >= H) return;
  const i = (y * W + x) * 4;
  // 与已有像素做 alpha 合成
  const sa = a / 255, da = 1 - sa;
  px[i]     = clamp(r * sa + px[i] * da, 0, 255);
  px[i + 1] = clamp(g * sa + px[i + 1] * da, 0, 255);
  px[i + 2] = clamp(b * sa + px[i + 2] * da, 0, 255);
  px[i + 3] = clamp(a + px[i + 3] * da, 0, 255);
};

/* 背景：近黑 + 一团暖光 */
for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) {
  const dx = (x - 128) / 128, dy = (y - 118) / 128;
  const d = Math.sqrt(dx * dx + dy * dy);
  const glow = Math.max(0, 1 - d) ** 2.2;
  set(x, y, 12 + glow * 46, 9 + glow * 16, 8 + glow * 10);
}

/* 灯笼本体：竖椭圆 + 左侧高光 + 上下收口 */
const cx = 128, cy = 122, rx = 66, ry = 78;
for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) {
  const nx = (x - cx) / rx, ny = (y - cy) / ry;
  const q = nx * nx + ny * ny;
  if (q > 1) continue;
  // 收腰：上下端略窄
  const pinch = 1 - Math.pow(Math.abs(ny), 3.2) * 0.34;
  if (Math.abs(nx) > pinch) continue;

  const hl = Math.max(0, 1 - Math.hypot((x - 104) / 34, (y - 96) / 40));   // 高光
  const rim = Math.pow(q, 1.6);                                            // 边缘压暗
  let r = 150 + hl * 105 - rim * 92;
  let g = 24 + hl * 46 - rim * 16;
  let b = 18 + hl * 30 - rim * 12;
  // 竖向骨架棱线
  const rib = Math.abs(Math.asin(clamp(nx / pinch, -1, 1)) * 7 % 2 - 1);
  const shade = 1 - rib * 0.16;
  r *= shade; g *= shade; b *= shade;
  set(x, y, clamp(r, 0, 255), clamp(g, 0, 255), clamp(b, 0, 255));
}

/* 灯罩金圈（上下） */
for (const yy of [cy - ry + 6, cy + ry - 8]) {
  for (let y = yy - 7; y <= yy + 7; y++) for (let x = cx - 40; x <= cx + 40; x++) {
    const t = 1 - Math.abs(y - yy) / 7;
    const ex = 1 - Math.pow(Math.abs(x - cx) / 40, 2);
    if (t <= 0 || ex <= 0) continue;
    set(x, y, clamp(206 * t * ex + 40, 0, 255), clamp(166 * t * ex + 30, 0, 255), clamp(74 * t * ex + 20, 0, 255));
  }
}

/* 顶部挂钩 */
for (let y = 8; y < cy - ry + 8; y++) { set(128, y, 58, 42, 24); set(129, y, 58, 42, 24); }

/* 底部流苏 */
for (let y = cy + ry - 2; y < 246; y++) {
  const t = (y - (cy + ry)) / (246 - (cy + ry));
  for (let x = 112; x <= 144; x++) {
    const sway = Math.sin(t * 3.1 + (x - 128) * 0.4) * 4 * t;
    if (Math.abs(x - 128 - sway) > 15 * (1 - t * 0.5)) continue;
    set(x, y, clamp(196 - t * 70, 0, 255), clamp(150 - t * 60, 0, 255), clamp(48 - t * 24, 0, 255));
  }
}

/* ---------- PNG 编码 ---------- */
function crc32(buf) {
  let c, table = [];
  for (let n = 0; n < 256; n++) { c = n; for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1; table[n] = c >>> 0; }
  let crc = 0xffffffff;
  for (const b of buf) crc = table[(crc ^ b) & 0xff] ^ (crc >>> 8);
  return (crc ^ 0xffffffff) >>> 0;
}
function chunk(type, data) {
  const len = Buffer.alloc(4); len.writeUInt32BE(data.length);
  const t = Buffer.from(type, 'ascii');
  const crc = Buffer.alloc(4); crc.writeUInt32BE(crc32(Buffer.concat([t, data])));
  return Buffer.concat([len, t, data, crc]);
}
const raw = Buffer.alloc(H * (W * 4 + 1));
for (let y = 0; y < H; y++) {
  raw[y * (W * 4 + 1)] = 0;                                  // filter: none
  px.copy(raw, y * (W * 4 + 1) + 1, y * W * 4, (y + 1) * W * 4);
}
const ihdr = Buffer.alloc(13);
ihdr.writeUInt32BE(W, 0); ihdr.writeUInt32BE(H, 4);
ihdr[8] = 8; ihdr[9] = 6;                                    // 8bit RGBA
const png = Buffer.concat([
  Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]),
  chunk('IHDR', ihdr),
  chunk('IDAT', zlib.deflateSync(raw, { level: 9 })),
  chunk('IEND', Buffer.alloc(0)),
]);

const out = path.join(__dirname, 'icon.png');
fs.writeFileSync(out, png);
console.log('✓ icon.png', (png.length / 1024).toFixed(1) + ' KB', '→', out);

#!/usr/bin/env node
/* =============================================================
 * pack-electron.js — 把 app 载荷注入 Electron 官方预编译包
 *
 * 为什么不用 unzip→rezip：
 *   darwin 的 zip 里有 14 个符号链接（Electron Framework.framework 的
 *   Versions/Current 等）和 15 个执行位；linux 有 8 个执行位（含
 *   chrome-sandbox）。Windows 上的解压/再压缩会丢掉这些元数据，
 *   得到的 .app 在 mac 上直接起不来。
 *   所以 mac/linux 采用「只追加」：原 zip 的字节与中央目录项原样保留，
 *   只在末尾追加我们的文件并重写中央目录 —— 符号链接和权限位不受影响。
 *
 *   Windows 的包没有这两类元数据，走正常解压→改名→再压缩。
 *
 * 用法：
 *   node desktop/pack-electron.js <in.zip> <out.zip> <appDir>
 *     appDir 里的内容会被放到 zip 内的 resources/app/ 下
 *   可选环境变量 EXTRA = 'name::mode::filePath' 用 ; 分隔，追加单文件
 *     （用于塞 start.sh / .desktop / README）
 * ============================================================= */
const fs = require('fs');
const path = require('path');
const zlib = require('zlib');

/* ---------- CRC32 ---------- */
const CRC_TABLE = (() => {
  const t = new Int32Array(256);
  for (let n = 0; n < 256; n++) {
    let c = n;
    for (let k = 0; k < 8; k++) c = (c & 1) ? (0xedb88320 ^ (c >>> 1)) : (c >>> 1);
    t[n] = c | 0;
  }
  return t;
})();
function crc32(buf) {
  let c = -1;
  for (let i = 0; i < buf.length; i++) c = CRC_TABLE[(c ^ buf[i]) & 0xff] ^ (c >>> 8);
  return (c ^ -1) >>> 0;
}

/* ---------- 读原 zip 的中央目录 ---------- */
function findEOCD(buf) {
  const min = Math.max(0, buf.length - 66000);
  for (let i = buf.length - 22; i >= min; i--) {
    if (buf.readUInt32LE(i) === 0x06054b50) return i;
  }
  throw new Error('不是有效的 zip（找不到 EOCD）');
}
function readCentral(buf) {
  const eocd = findEOCD(buf);
  const total = buf.readUInt16LE(eocd + 10);
  const cdOff = buf.readUInt32LE(eocd + 16);
  const cdSize = buf.readUInt32LE(eocd + 12);
  const entries = [];
  let p = cdOff;
  for (let i = 0; i < total; i++) {
    if (buf.readUInt32LE(p) !== 0x02014b50) throw new Error('中央目录项 ' + i + ' 签名不对');
    const nameLen = buf.readUInt16LE(p + 28);
    const extraLen = buf.readUInt16LE(p + 30);
    const cmtLen = buf.readUInt16LE(p + 32);
    const lhOff = buf.readUInt32LE(p + 42);
    // 从本地头取真实数据起点与压缩方式
    if (buf.readUInt32LE(lhOff) !== 0x04034b50) throw new Error('本地头签名不对');
    const lName = buf.readUInt16LE(lhOff + 26), lExtra = buf.readUInt16LE(lhOff + 28);
    const method = buf.readUInt16LE(lhOff + 8);
    const csize = buf.readUInt32LE(lhOff + 18);
    const dataStart = lhOff + 30 + lName + lExtra;
    entries.push({
      raw: buf.slice(p, p + 46 + nameLen + extraLen + cmtLen),
      name: buf.toString('utf8', p + 46, p + 46 + nameLen),
      dataRange: [dataStart, dataStart + csize],
      method,
    });
    p += 46 + nameLen + extraLen + cmtLen;
  }
  return { eocd, cdOff, cdSize, entries };
}

/* ---------- 造新条目 ---------- */
function dosTime(d) {
  return ((d.getHours() << 11) | (d.getMinutes() << 5) | (d.getSeconds() >> 1)) & 0xffff;
}
function dosDate(d) {
  return (((d.getFullYear() - 1980) << 9) | ((d.getMonth() + 1) << 5) | d.getDate()) & 0xffff;
}
const NOW = new Date();

/** 生成 [localHeader+data, centralHeader] */
function makeEntry(name, content, { dir = false, mode = 0o100644 } = {}) {
  const nameBuf = Buffer.from(name, 'utf8');
  const crc = dir ? 0 : crc32(content);
  const comp = dir ? Buffer.alloc(0) : zlib.deflateRawSync(content, { level: 9 });
  const useStore = dir || comp.length >= content.length;
  const data = useStore ? (dir ? Buffer.alloc(0) : content) : comp;
  const method = useStore ? 0 : 8;

  const lh = Buffer.alloc(30);
  lh.writeUInt32LE(0x04034b50, 0);
  lh.writeUInt16LE(20, 4);
  lh.writeUInt16LE(0x0800, 6);              // bit11 = UTF-8 文件名
  lh.writeUInt16LE(method, 8);
  lh.writeUInt16LE(dosTime(NOW), 10);
  lh.writeUInt16LE(dosDate(NOW), 12);
  lh.writeUInt32LE(crc, 14);
  lh.writeUInt32LE(data.length, 18);
  lh.writeUInt32LE(dir ? 0 : content.length, 22);
  lh.writeUInt16LE(nameBuf.length, 26);
  lh.writeUInt16LE(0, 28);
  const local = Buffer.concat([lh, nameBuf, data]);

  const ch = Buffer.alloc(46);
  ch.writeUInt32LE(0x02014b50, 0);
  ch.writeUInt8(3, 4);                       // 由 unix 造 —— 外部属性里的 mode 才生效
  ch.writeUInt8(0, 5);
  ch.writeUInt16LE(20, 6);
  ch.writeUInt16LE(0x0800, 8);
  ch.writeUInt16LE(method, 10);
  ch.writeUInt16LE(dosTime(NOW), 12);
  ch.writeUInt16LE(dosDate(NOW), 14);
  ch.writeUInt32LE(crc, 16);
  ch.writeUInt32LE(data.length, 20);
  ch.writeUInt32LE(dir ? 0 : content.length, 24);
  ch.writeUInt16LE(nameBuf.length, 28);
  ch.writeUInt16LE(0, 30);
  ch.writeUInt16LE(0, 32);
  ch.writeUInt32LE(0, 34);
  ch.writeUInt32LE((mode << 16) >>> 0, 38);  // unix 权限
  const central = Buffer.concat([ch, nameBuf]);
  return { local, central, size: local.length, dir };
}

/** 只追加：原字节原样保留，新数据接在最后，中央目录重写 */
function appendEntries(zipBuf, newEntries) {
  const { eocd, cdOff, entries } = readCentral(zipBuf);
  const head = zipBuf.slice(0, cdOff);                 // 全部本地数据（含尾部数据描述符若有）
  const base = cdOff;
  let appended = Buffer.alloc(0);
  const addedCentrals = [];

  for (const e of newEntries) {
    e.lhOff = base + appended.length;
    appended = Buffer.concat([appended, e.local]);
    const ch = e.central.slice(0, 46);          // 固定头就是 46 字节
    ch.writeUInt32LE(e.lhOff, 42);              // 相对本地头偏移
    addedCentrals.push(Buffer.concat([ch, e.central.slice(46)]));
  }

  const oldCentrals = entries.map(en => Buffer.from(en.raw));  // 原偏移不变，原样写回
  const cd = Buffer.concat([...oldCentrals, ...addedCentrals]);

  const eo = Buffer.alloc(22);
  eo.writeUInt32LE(0x06054b50, 0);
  eo.writeUInt16LE(0, 4); eo.writeUInt16LE(0, 6);
  const total = entries.length + addedCentrals.length;
  eo.writeUInt16LE(total, 8); eo.writeUInt16LE(total, 10);
  eo.writeUInt32LE(cd.length, 12);
  eo.writeUInt32LE(base + appended.length, 16);        // 新中央目录位置
  eo.writeUInt16LE(0, 20);

  return Buffer.concat([head, appended, cd, eo]);
}

/* ---------- 收集 app 目录 ---------- */
function collect(dir, prefix) {
  const out = [];
  for (const f of fs.readdirSync(dir)) {
    const full = path.join(dir, f);
    const name = prefix + '/' + f;
    const st = fs.statSync(full);
    if (st.isDirectory()) {
      out.push(makeEntry(name + '/', null, { dir: true, mode: 0o040755 }));
      out.push(...collect(full, name));
    } else {
      out.push(makeEntry(name, fs.readFileSync(full)));
    }
  }
  return out;
}

function main() {
  const [inZip, outZip, appDir] = process.argv.slice(2);
  if (!inZip || !outZip || !appDir) {
    console.error('用法: node pack-electron.js <in.zip> <out.zip> <appDir> [EXTRA=...]');
    process.exit(1);
  }
  const buf = fs.readFileSync(inZip);
  const before = readCentral(buf).entries.length;

  const entries = collect(appDir, 'resources/app');
  // 显式目录项：多数解压器能隐式建父目录，但个别严格实现会失败，成本极低就补上
  entries.unshift(makeEntry('resources/app/', null, { dir: true, mode: 0o040755 }));
  entries.unshift(makeEntry('resources/', null, { dir: true, mode: 0o040755 }));

  // EXTRA='显示名::八进制mode::绝对路径' 用 ; 分隔
  if (process.env.EXTRA) {
    for (const spec of process.env.EXTRA.split(';').filter(Boolean)) {
      const [name, mode, file] = spec.split('::');
      if (!name || !file) continue;
      entries.push(makeEntry(name, fs.readFileSync(file),
        { mode: parseInt(mode || '644', 8) | 0o100000 }));
    }
  }

  const out = appendEntries(buf, entries);
  fs.writeFileSync(outZip, out);

  const after = readCentral(out).entries.length;
  console.log(`✓ ${path.basename(outZip)}`);
  console.log(`  条目 ${before} → ${after}（新增 ${after - before}）`);
  console.log(`  ${(out.length / 1048576).toFixed(1)} MB · 原有字节未改动，符号链接与权限位保留`);
}

main();

