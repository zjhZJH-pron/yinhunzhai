  /* ============ P10 九宫门闩（洛书幻方）============ */
  jiugong(data){
    const app=this.app;
    const grid=Array(9).fill(null);
    let pick=null;
    const win=(...a)=>this.win(...a),note=(...a)=>this.note(...a);
    this.show({title:'九重门闩 · 九宫算',wide:true,
